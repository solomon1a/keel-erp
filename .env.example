# Local Postgres (Docker Compose or a Postgres you install). Both URLs are the same
# on a single server. On Neon, DATABASE_URL is the pooled host and DATABASE_URL_UNPOOLED is direct.
DATABASE_URL="postgresql://keel:keel@127.0.0.1:5432/keel?schema=public"
DATABASE_URL_UNPOOLED="postgresql://keel:keel@127.0.0.1:5432/keel?schema=public"

# At least 16 characters. Use a unique value on any shared URL (`openssl rand -base64 32`).
# Changing it signs everyone out. Do not use this dev value in production.
SESSION_SECRET="keel-dev-session-secret-change-me"

# Invite email. Leave these empty locally and Keel shows the link to copy.
# On Vercel, set RESEND_API_KEY and MAIL_FROM. Or set SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, and MAIL_FROM.
# MAIL_FROM="Keel <invites@example.com>"
# RESEND_API_KEY=""
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# APP_ORIGIN="https://example.com"
