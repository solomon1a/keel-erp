model SupplierQuotation {
  id                Int                     @id @default(autoincrement())
  companyId         Int
  company           Company                 @relation(fields: [companyId], references: [id])
  name              String
  vendorId          Int
  vendor            Contact                 @relation(fields: [vendorId], references: [id])
  materialRequestId Int?
  materialRequest   MaterialRequest?        @relation(fields: [materialRequestId], references: [id])
  purchaseOrderId   Int?
  purchaseOrder     PurchaseOrder?          @relation(fields: [purchaseOrderId], references: [id])
  /// draft or received
  state             String
  lines             SupplierQuotationLine[]
  createdAt         DateTime                @default(now())

  @@unique([companyId, name])
}

model SupplierQuotationLine {
  id        Int               @id @default(autoincrement())
  quoteId   Int
  quote     SupplierQuotation @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId Int
  quantity  Float
  unitCost  Float
}

/// One guided-demo walk for a company. Document ids are plain numbers so a reset can delete the documents first.
model DemoRun {
  id                   Int      @id @default(autoincrement())
  companyId            Int
  company              Company  @relation(fields: [companyId], references: [id])
  userId               Int
  user                 User     @relation(fields: [userId], references: [id])
  step                 Int      @default(0)
  /// active, done, or skipped
  status               String   @default("active")
  serial               Int
  leadId               Int?
  quotationId          Int?
  salesOrderId         Int?
  purchaseOrderId      Int?
  manufacturingOrderId Int?
  invoiceId            Int?
  contactId            Int?
  finishedId           Int?
  componentId          Int?
  note                 String?
  /// Baseline stock and the story (product, material, quantity) captured before the first change.
  snapshot             Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([companyId])
}

/// Default accounts for a class of fixed assets. Depreciation posts through these.
model AssetCategory {
  id               Int      @id @default(autoincrement())
  companyId        Int
  company          Company  @relation(fields: [companyId], references: [id])
  name             String
  assetAccountId   Int
  assetAccount     Account  @relation("AssetAccount", fields: [assetAccountId], references: [id])
  accumAccountId   Int
  accumAccount     Account  @relation("AccumAccount", fields: [accumAccountId], references: [id])
  expenseAccountId Int
  expenseAccount   Account  @relation("DepExpenseAccount", fields: [expenseAccountId], references: [id])
  /// straight_line or declining
  method           String
  months           Int
  /// monthly
  frequency        String   @default("monthly")
  assets           Asset[]

  @@unique([companyId, name])
}

model Asset {
  id              Int                  @id @default(autoincrement())
  companyId       Int
  company         Company              @relation(fields: [companyId], references: [id])
  name            String
  categoryId      Int
  category        AssetCategory        @relation(fields: [categoryId], references: [id])
  purchaseValue   Float
  salvageValue    Float
  startDate       DateTime
  /// straight_line or declining
  method          String
  months          Int
  /// open, disposed, or sold
  state           String
  invoiceLineId   Int?                 @unique
  invoiceLine     InvoiceLine?         @relation(fields: [invoiceLineId], references: [id])
  disposalDate    DateTime?
  disposalPrice   Float?
  disposalEntryId Int?                 @unique
  disposalEntry   JournalEntry?        @relation("AssetDisposal", fields: [disposalEntryId], references: [id])
  lines           AssetDepreciation[]
  createdAt       DateTime             @default(now())

  @@unique([companyId, name])
  @@index([companyId, state])
}

model AssetDepreciation {
  id      Int           @id @default(autoincrement())
  assetId Int
  asset   Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date    DateTime
  amount  Float
  /// draft or posted
  state   String
  entryId Int?          @unique
  entry   JournalEntry? @relation(fields: [entryId], references: [id])

  @@unique([assetId, date])
}

model SubcontractOrder {
  id         Int                     @id @default(autoincrement())
  companyId  Int
  company    Company                 @relation(fields: [companyId], references: [id])
  name       String
  vendorId   Int
  vendor     Contact                 @relation("SubcontractVendor", fields: [vendorId], references: [id])
  productId  Int
  product    Product                 @relation("SubFinished", fields: [productId], references: [id])
  bomId      Int
  bom        BillOfMaterials         @relation(fields: [bomId], references: [id])
  locationId Int
  location   StockLocation           @relation(fields: [locationId], references: [id])
  quantity   Float
  /// Untaxed service fee for one finished unit.
  fee        Float
  /// draft, confirmed, progress, done, or cancel
  state      String
  received   Float                   @default(0)
  lines      SubcontractComponent[]
  receipts   SubcontractReceipt[]
  moves      StockMove[]
  createdAt  DateTime                @default(now())

  @@unique([companyId, name])
  @@index([companyId, state])
}

model SubcontractComponent {
  id        Int               @id @default(autoincrement())
  orderId   Int
  order     SubcontractOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product           @relation(fields: [productId], references: [id])
  /// Component quantity for one finished unit.
  perUnit   Float
  sent      Float             @default(0)
  consumed  Float             @default(0)
  valueSent Float             @default(0)
  valueUsed Float             @default(0)

  @@unique([orderId, productId])
}

model SubcontractReceipt {
  id            Int              @id @default(autoincrement())
  orderId       Int
  order         SubcontractOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quantity      Float
  componentCost Float
  fee           Float
  invoiceId     Int?
  invoice       Invoice?         @relation(fields: [invoiceId], references: [id])
  date          DateTime
}

model UserInvite {
  id          Int       @id @default(autoincrement())
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id])
  email       String
  role        String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById Int
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([companyId, email])
}
