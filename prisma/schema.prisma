generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id             Int             @id @default(autoincrement())
  name           String
  city           String
  /// ISO 4217 code. One currency on the company until a later multi-currency slice.
  currency       String          @default("CNY")
  defaultTaxRate Float           @default(13)
  users     User[]
  contacts  Contact[]
  products  Product[]
  orders        SalesOrder[]
  purchases     PurchaseOrder[]
  boms          BillOfMaterials[]
  manufacturing ManufacturingOrder[]
  locations     StockLocation[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model User {
  id              Int          @id @default(autoincrement())
  name            String
  email           String       @unique
  passwordHash    String
  role            String
  companyId       Int
  company         Company      @relation(fields: [companyId], references: [id])
  sessions        Session[]
  createdContacts Contact[]    @relation("ContactCreatedBy")
  updatedContacts Contact[]    @relation("ContactUpdatedBy")
  createdOrders    SalesOrder[]    @relation("OrderCreatedBy")
  createdPurchases     PurchaseOrder[]     @relation("PurchaseCreatedBy")
  createdManufacturing ManufacturingOrder[] @relation("ManufacturingCreatedBy")
  createdAt            DateTime            @default(now())
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Country {
  id       Int       @id @default(autoincrement())
  name     String
  code     String    @unique
  contacts Contact[]
}

model Contact {
  id          Int          @id @default(autoincrement())
  name        String
  email       String?
  phone       String?
  isCompany   Boolean      @default(false)
  isCustomer  Boolean      @default(false)
  isSupplier  Boolean      @default(false)
  isEmployee  Boolean      @default(false)
  street      String?
  city        String?
  state       String?
  postalCode  String?
  notes       String?
  parentId    Int?
  parent      Contact?     @relation("ContactHierarchy", fields: [parentId], references: [id])
  children    Contact[]    @relation("ContactHierarchy")
  countryId   Int?
  country     Country?     @relation(fields: [countryId], references: [id])
  companyId      Int
  company        Company         @relation(fields: [companyId], references: [id])
  orders         SalesOrder[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt   DateTime     @updatedAt
  createdById Int?
  updatedById Int?
  createdBy   User?        @relation("ContactCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?        @relation("ContactUpdatedBy", fields: [updatedById], references: [id])

  @@index([companyId, name])
}

model Tax {
  id             Int                 @id @default(autoincrement())
  name           String
  rate           Float
  isDefault      Boolean             @default(false)
  lines          SalesOrderLine[]
  purchaseLines  PurchaseOrderLine[]
}

model Product {
  id           Int                 @id @default(autoincrement())
  name         String
  sku          String
  /// `product` (stocked) or `service`.
  type         String
  /// `finished` goods or `raw` material. Services stay `finished`.
  kind         String              @default("finished")
  listPrice    Float
  costPrice    Float               @default(0)
  purchasable  Boolean             @default(false)
  description  String?
  active       Boolean             @default(true)
  companyId    Int
  company      Company             @relation(fields: [companyId], references: [id])
  lines                    SalesOrderLine[]
  purchaseLines            PurchaseOrderLine[]
  boms                     BillOfMaterials[]        @relation("BomFinished")
  bomLines                 BomLine[]
  manufacturingOrders      ManufacturingOrder[]
  manufacturingComponents  ManufacturingComponent[]
  quants                   StockQuant[]
  moves                    StockMove[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([companyId, sku])
}

model Sequence {
  id   Int    @id @default(autoincrement())
  name String @unique
  next Int    @default(0)
}

model SalesOrder {
  id            Int              @id @default(autoincrement())
  name          String
  state         String
  customerId    Int
  customer      Contact          @relation(fields: [customerId], references: [id])
  companyId     Int
  company       Company          @relation(fields: [companyId], references: [id])
  dateOrder     DateTime
  validityDate  DateTime?
  amountUntaxed Float
  amountTax     Float
  amountTotal   Float
  lines         SalesOrderLine[]
  moves         StockMove[]
  createdById   Int?
  createdBy     User?            @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([companyId, name])
  @@index([companyId, state])
}

model SalesOrderLine {
  id        Int         @id @default(autoincrement())
  orderId   Int
  order     SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product     @relation(fields: [productId], references: [id])
  description String
  quantity  Float
  unitPrice Float
  discount  Float       @default(0)
  taxId     Int?
  tax       Tax?        @relation(fields: [taxId], references: [id])
  subtotal  Float
  taxAmount Float
}

model PurchaseOrder {
  id            Int                 @id @default(autoincrement())
  name          String
  /// draft (RFQ), sent, purchase (confirmed), done (received), cancel
  state         String
  vendorId      Int
  vendor        Contact             @relation(fields: [vendorId], references: [id])
  companyId     Int
  company       Company             @relation(fields: [companyId], references: [id])
  dateOrder     DateTime
  amountUntaxed Float
  amountTax     Float
  amountTotal   Float
  lines         PurchaseOrderLine[]
  moves         StockMove[]
  createdById   Int?
  createdBy     User?               @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([companyId, name])
  @@index([companyId, state])
}

model PurchaseOrderLine {
  id          Int           @id @default(autoincrement())
  orderId     Int
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product       @relation(fields: [productId], references: [id])
  description String
  quantity    Float
  unitCost    Float
  taxId       Int?
  tax         Tax?          @relation(fields: [taxId], references: [id])
  subtotal    Float
  taxAmount   Float
}

model BillOfMaterials {
  id         Int                  @id @default(autoincrement())
  productId  Int                  @unique
  product    Product              @relation("BomFinished", fields: [productId], references: [id])
  companyId  Int
  company    Company              @relation(fields: [companyId], references: [id])
  /// Finished units this recipe makes. Component quantities are for this many units.
  yieldQty   Float                @default(1)
  notes      String?
  lines      BomLine[]
  orders     ManufacturingOrder[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([companyId])
}

model BomLine {
  id        Int             @id @default(autoincrement())
  bomId     Int
  bom       BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  productId Int
  product   Product         @relation(fields: [productId], references: [id])
  quantity  Float
}

model ManufacturingOrder {
  id             Int                       @id @default(autoincrement())
  name           String
  /// draft, confirmed, progress, done, cancel
  state          String
  productId      Int
  product        Product                   @relation(fields: [productId], references: [id])
  bomId          Int
  bom            BillOfMaterials           @relation(fields: [bomId], references: [id])
  companyId      Int
  company        Company                   @relation(fields: [companyId], references: [id])
  quantity       Float
  quantityDone   Float                     @default(0)
  lines          ManufacturingComponent[]
  moves          StockMove[]
  createdById    Int?
  createdBy      User?                     @relation("ManufacturingCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([companyId, name])
  @@index([companyId, state])
}

model ManufacturingComponent {
  id        Int                 @id @default(autoincrement())
  orderId   Int
  order     ManufacturingOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product             @relation(fields: [productId], references: [id])
  /// Total component quantity for the full order.
  quantity  Float
  consumed  Float               @default(0)
}

model StockLocation {
  id        Int          @id @default(autoincrement())
  name      String
  type      String
  companyId Int
  company   Company      @relation(fields: [companyId], references: [id])
  quants    StockQuant[]
  movesFrom StockMove[]  @relation("MoveFrom")
  movesTo   StockMove[]  @relation("MoveTo")

  @@unique([companyId, type])
}

model StockQuant {
  id         Int           @id @default(autoincrement())
  productId  Int
  product    Product       @relation(fields: [productId], references: [id])
  locationId Int
  location   StockLocation @relation(fields: [locationId], references: [id])
  quantity   Float

  @@unique([productId, locationId])
}

model StockMove {
  id             Int           @id @default(autoincrement())
  productId      Int
  product        Product       @relation(fields: [productId], references: [id])
  locationFromId Int
  locationFrom   StockLocation @relation("MoveFrom", fields: [locationFromId], references: [id])
  locationToId   Int
  locationTo     StockLocation @relation("MoveTo", fields: [locationToId], references: [id])
  quantity       Float
  state          String
  reference       String
  orderId         Int?
  order           SalesOrder?    @relation(fields: [orderId], references: [id])
  purchaseOrderId      Int?
  purchaseOrder        PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  manufacturingOrderId Int?
  manufacturingOrder   ManufacturingOrder? @relation(fields: [manufacturingOrderId], references: [id])
  date                 DateTime
}
