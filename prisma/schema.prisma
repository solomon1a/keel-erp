generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Company {
  id             Int             @id @default(autoincrement())
  name           String
  city           String
  /// ISO 4217 code. One currency on the company until a later multi-currency slice.
  currency       String          @default("CNY")
  defaultTaxRate Float           @default(13)
  users     User[]
  contacts  Contact[]
  products  Product[]
  orders        SalesOrder[]
  purchases     PurchaseOrder[]
  boms          BillOfMaterials[]
  manufacturing ManufacturingOrder[]
  workstations  Workstation[]
  jobCards      JobCard[]
  wastageEntries WastageEntry[]
  productionPlans ProductionPlan[]
  warehouses    Warehouse[]
  transfers     StockTransfer[]
  reorderRules  ReorderRule[]
  locations     StockLocation[]
  categories    ProductCategory[]
  posSessions   PosSession[]
  posOrders     PosOrder[]
  shopCustomers ShopCustomer[]
  accounts      Account[]
  journals      Journal[]
  invoices      Invoice[]
  entries       JournalEntry[]
  fiscalYears   FiscalYear[]
  costCentres   CostCentre[]
  chargeTemplates ChargeTemplate[]
  stockLedgers  StockLedger[]
  stockBatches  StockBatch[]
  stockSerials  StockSerial[]
  leads         Lead[]
  departments   Department[]
  employees     Employee[]
  salaryStructures SalaryStructure[]
  payrollRuns   PayrollRun[]
  expenses      ExpenseClaim[]
  deskRecords   DeskRecord[]
  moduleSettings ModuleSetting[]
  /// Seller taxpayer ID printed on invoices. Not a Golden Tax registration.
  taxId         String?
  address       String?
  /// No journal, payment, or stock valuation is posted on or before this date.
  lockDate      DateTime?
  taxLockDate   DateTime?
  accessGroups  AccessGroup[]
  savedFilters  SavedFilter[]
  chatter       ChatterMessage[]
  statements    BankStatement[]
  valuations    ValuationLayer[]
  routes        StockRoute[]
  customerGroups CustomerGroup[]
  priceLists     PriceList[]
  pricingRules   PricingRule[]
  quotations     Quotation[]
  deliveryNotes  DeliveryNote[]
  receipts       PurchaseReceipt[]
  materialRequests MaterialRequest[]
  supplierQuotes SupplierQuotation[]
  demoRuns       DemoRun[]
  exchangeRates  ExchangeRate[]
  assetCategories AssetCategory[]
  assets         Asset[]
  subcontractOrders SubcontractOrder[]
  invites        UserInvite[]
  /// Warehouse that fills online orders. Empty uses the default warehouse.
  onlineWarehouseId Int?
  onlineWarehouse   Warehouse? @relation("CompanyOnlineWarehouse", fields: [onlineWarehouseId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model User {
  id              Int          @id @default(autoincrement())
  name            String
  email           String       @unique
  passwordHash    String
  role            String
  companyId       Int
  company         Company      @relation(fields: [companyId], references: [id])
  sessions        Session[]
  createdContacts Contact[]    @relation("ContactCreatedBy")
  updatedContacts Contact[]    @relation("ContactUpdatedBy")
  createdOrders    SalesOrder[]    @relation("OrderCreatedBy")
  createdPurchases     PurchaseOrder[]     @relation("PurchaseCreatedBy")
  createdManufacturing ManufacturingOrder[] @relation("ManufacturingCreatedBy")
  createdTransfers     StockTransfer[]     @relation("TransferCreatedBy")
  openedSessions       PosSession[]        @relation("PosOpenedBy")
  closedSessions       PosSession[]        @relation("PosClosedBy")
  posOrders            PosOrder[]          @relation("PosOrderCreatedBy")
  leads                Lead[]
  memberships          GroupMember[]
  savedFilters         SavedFilter[]
  chatter              ChatterMessage[]
  demoRuns             DemoRun[]
  invitesSent          UserInvite[]
  /// ISO code used only to format amounts. Empty follows the company currency. The books stay in that currency.
  displayCurrency      String?
  createdAt            DateTime            @default(now())
}

/// How many units of `currency` equal one unit of the company currency. A demo table until an admin edits it.
model ExchangeRate {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  currency  String
  rate      Float

  @@unique([companyId, currency])
  @@index([companyId])
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Country {
  id       Int       @id @default(autoincrement())
  name     String
  code     String    @unique
  contacts Contact[]
}

model Contact {
  id          Int          @id @default(autoincrement())
  name        String
  email       String?
  phone       String?
  isCompany   Boolean      @default(false)
  isCustomer  Boolean      @default(false)
  isSupplier  Boolean      @default(false)
  isEmployee  Boolean      @default(false)
  street      String?
  city        String?
  state       String?
  postalCode  String?
  /// Buyer taxpayer identification number for a fapiao-ready invoice.
  taxId       String?
  /// Zero means the customer is not held to a credit limit.
  creditLimit Float        @default(0)
  customerGroupId Int?
  customerGroup   CustomerGroup? @relation(fields: [customerGroupId], references: [id])
  notes       String?
  subcontracts ManufacturingOrder[] @relation("MoSupplier")
  parentId    Int?
  parent      Contact?     @relation("ContactHierarchy", fields: [parentId], references: [id])
  children    Contact[]    @relation("ContactHierarchy")
  countryId   Int?
  country     Country?     @relation(fields: [countryId], references: [id])
  companyId      Int
  company        Company         @relation(fields: [companyId], references: [id])
  orders         SalesOrder[]
  purchaseOrders PurchaseOrder[]
  posOrders      PosOrder[]
  shopCustomers  ShopCustomer[]
  invoices       Invoice[]
  quotations     Quotation[]
  supplierQuotes SupplierQuotation[]
  subcontractLocations StockLocation[] @relation("SubcontractVendor")
  subcontractOrders SubcontractOrder[] @relation("SubcontractVendor")
  customerRules  PricingRule[] @relation("RuleCustomer")
  vendorRules    PricingRule[] @relation("RuleVendor")
  leads          Lead[]
  createdAt      DateTime        @default(now())
  updatedAt   DateTime     @updatedAt
  createdById Int?
  updatedById Int?
  createdBy   User?        @relation("ContactCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?        @relation("ContactUpdatedBy", fields: [updatedById], references: [id])

  @@index([companyId, name])
}

model Tax {
  id             Int                 @id @default(autoincrement())
  name           String
  rate           Float
  isDefault      Boolean             @default(false)
  lines          SalesOrderLine[]
  purchaseLines  PurchaseOrderLine[]
}

model Product {
  id           Int                 @id @default(autoincrement())
  name         String
  sku          String
  /// `product` (stocked) or `service`.
  type         String
  /// `finished` goods or `raw` material. Services stay `finished`.
  kind         String              @default("finished")
  listPrice    Float
  costPrice    Float               @default(0)
  /// `fifo` or `avco`. Receipts and issues post a valuation layer.
  costMethod   String              @default("avco")
  purchasable  Boolean             @default(false)
  /// `none`, `lot`, or `serial`. The number is recorded on the stock move.
  tracking     String              @default("none")
  description  String?
  active       Boolean             @default(true)
  companyId    Int
  company      Company             @relation(fields: [companyId], references: [id])
  lines                    SalesOrderLine[]
  purchaseLines            PurchaseOrderLine[]
  boms                     BillOfMaterials[]        @relation("BomFinished")
  subcontractFinished      SubcontractOrder[]       @relation("SubFinished")
  subcontractParts         SubcontractComponent[]
  bomLines                 BomLine[]
  bomByproducts            BomByproduct[]           @relation("BomByproduct")
  wastageEntries           WastageEntry[]
  manufacturingOrders      ManufacturingOrder[]
  manufacturingComponents  ManufacturingComponent[]
  quants                   StockQuant[]
  moves                    StockMove[]
  reorderRules             ReorderRule[]
  transferLines            StockTransferLine[]
  categoryId   Int?
  category     ProductCategory?    @relation(fields: [categoryId], references: [id])
  /// Shop barcode. Empty products are not looked up from the register scanner.
  barcode      String?
  /// Shown on the public shop. Raw materials stay off unless someone publishes them.
  websitePublished Boolean          @default(false)
  posLines     PosOrderLine[]
  valuations   ValuationLayer[]
  ledgers      StockLedger[]
  batches      StockBatch[]
  serials      StockSerial[]
  priceItems   PriceListItem[]
  pricingRules PricingRule[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([categoryId])
}

model ProductCategory {
  id        Int       @id @default(autoincrement())
  name      String
  companyId Int
  company   Company   @relation(fields: [companyId], references: [id])
  products  Product[]

  @@unique([companyId, name])
}

model ShopCustomer {
  id           Int           @id @default(autoincrement())
  name         String
  email        String
  passwordHash String
  phone        String?
  contactId    Int
  contact      Contact       @relation(fields: [contactId], references: [id])
  companyId    Int
  company      Company       @relation(fields: [companyId], references: [id])
  sessions     ShopSession[]
  createdAt    DateTime      @default(now())

  @@unique([companyId, email])
}

model ShopSession {
  id         Int          @id @default(autoincrement())
  tokenHash  String       @unique
  customerId Int
  customer   ShopCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime     @default(now())

  @@index([customerId])
}

model Sequence {
  id   Int    @id @default(autoincrement())
  name String @unique
  next Int    @default(0)
}

model SalesOrder {
  id            Int              @id @default(autoincrement())
  name          String
  state         String
  customerId    Int
  customer      Contact          @relation(fields: [customerId], references: [id])
  companyId     Int
  company       Company          @relation(fields: [companyId], references: [id])
  dateOrder     DateTime
  validityDate  DateTime?
  amountUntaxed Float
  amountTax     Float
  amountTotal   Float
  lines         SalesOrderLine[]
  moves         StockMove[]
  invoices      Invoice[]
  quotations    Quotation[]
  deliveries    DeliveryNote[]
  manufacturingOrders ManufacturingOrder[]
  warehouseId   Int?
  warehouse     Warehouse?       @relation(fields: [warehouseId], references: [id])
  /// `desk` or `shop`.
  origin        String           @default("desk")
  /// `wechat`, `alipay`, or `card` when the order came from the shop. Recorded only.
  paymentMethod String?
  /// `recorded` when a shop payment was stored. No gateway capture.
  paymentState  String?
  publicToken   String?          @unique
  createdById   Int?
  createdBy     User?            @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([companyId, name])
  @@index([companyId, state])
  @@index([companyId, dateOrder])
  @@index([companyId, updatedAt])
}

model SalesOrderLine {
  id        Int         @id @default(autoincrement())
  orderId   Int
  order     SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product     @relation(fields: [productId], references: [id])
  description String
  quantity  Float
  unitPrice Float
  discount  Float       @default(0)
  taxId     Int?
  tax       Tax?        @relation(fields: [taxId], references: [id])
  subtotal  Float
  taxAmount Float
  qtyDelivered Float @default(0)
  qtyInvoiced  Float @default(0)
  deliveryLines DeliveryNoteLine[]
  invoiceLines  InvoiceLine[]
}

model PurchaseOrder {
  id            Int                 @id @default(autoincrement())
  name          String
  /// draft (RFQ), sent, purchase (confirmed), done (received), cancel
  state         String
  vendorId      Int
  vendor        Contact             @relation(fields: [vendorId], references: [id])
  companyId     Int
  company       Company             @relation(fields: [companyId], references: [id])
  dateOrder     DateTime
  amountUntaxed Float
  amountTax     Float
  amountTotal   Float
  lines         PurchaseOrderLine[]
  moves         StockMove[]
  invoices      Invoice[]
  receipts      PurchaseReceipt[]
  quotes        SupplierQuotation[]
  warehouseId   Int?
  warehouse     Warehouse?          @relation(fields: [warehouseId], references: [id])
  createdById   Int?
  createdBy     User?               @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([companyId, name])
  @@index([companyId, state])
  @@index([companyId, dateOrder])
}

model PurchaseOrderLine {
  id          Int           @id @default(autoincrement())
  orderId     Int
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product       @relation(fields: [productId], references: [id])
  description String
  quantity    Float
  unitCost    Float
  taxId       Int?
  tax         Tax?          @relation(fields: [taxId], references: [id])
  subtotal    Float
  taxAmount   Float
  qtyReceived Float         @default(0)
  qtyBilled   Float         @default(0)
  receiptLines PurchaseReceiptLine[]
  invoiceLines InvoiceLine[]
}

model BillOfMaterials {
  id         Int                  @id @default(autoincrement())
  productId  Int
  product    Product              @relation("BomFinished", fields: [productId], references: [id])
  companyId  Int
  company    Company              @relation(fields: [companyId], references: [id])
  /// Finished units this recipe makes. Component quantities are for this many units.
  yieldQty   Float                @default(1)
  version    Int                  @default(1)
  active     Boolean              @default(true)
  notes      String?
  lines      BomLine[]
  operations BomOperation[]
  byproducts BomByproduct[]
  orders     ManufacturingOrder[]
  subcontractOrders SubcontractOrder[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([productId, version])
  @@index([companyId, active])
}

model BomLine {
  id          Int             @id @default(autoincrement())
  bomId       Int
  bom         BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product         @relation(fields: [productId], references: [id])
  quantity    Float
  lossPercent Float           @default(0)
}

model Workstation {
  id        Int            @id @default(autoincrement())
  companyId Int
  company   Company        @relation(fields: [companyId], references: [id])
  name      String
  hourRate  Float
  operations BomOperation[]
  jobCards  JobCard[]
  wastage   WastageEntry[]

  @@unique([companyId, name])
}

model BomOperation {
  id            Int             @id @default(autoincrement())
  bomId         Int
  bom           BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  sequence      Int
  name          String
  workstationId Int
  workstation   Workstation     @relation(fields: [workstationId], references: [id])
  hours         Float
  lossPercent   Float           @default(0)
}

model BomByproduct {
  id        Int             @id @default(autoincrement())
  bomId     Int
  bom       BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  productId Int
  product   Product         @relation("BomByproduct", fields: [productId], references: [id])
  quantity  Float
}

model ManufacturingOrder {
  id             Int                       @id @default(autoincrement())
  name           String
  /// draft, confirmed, progress, done, cancel
  state          String
  productId      Int
  product        Product                   @relation(fields: [productId], references: [id])
  bomId          Int
  bom            BillOfMaterials           @relation(fields: [bomId], references: [id])
  companyId      Int
  company        Company                   @relation(fields: [companyId], references: [id])
  quantity       Float
  quantityDone   Float                     @default(0)
  /// stock, order, or subcontract
  purpose             String                    @default("stock")
  salesOrderId        Int?
  salesOrder          SalesOrder?               @relation(fields: [salesOrderId], references: [id])
  materialRequestId   Int?
  materialRequest     MaterialRequest?          @relation(fields: [materialRequestId], references: [id])
  supplierId          Int?
  supplier            Contact?                  @relation("MoSupplier", fields: [supplierId], references: [id])
  subcontractState    String?
  transferred         Boolean                   @default(false)
  operatingAbsorbed   Float                     @default(0)
  relieved            Float                     @default(0)
  quantityRejected    Float                     @default(0)
  lines          ManufacturingComponent[]
  moves             StockMove[]
  jobCards          JobCard[]
  wastage           WastageEntry[]
  sourceWarehouseId Int?
  sourceWarehouse   Warehouse?                @relation("MoSource", fields: [sourceWarehouseId], references: [id])
  destWarehouseId   Int?
  destWarehouse     Warehouse?                @relation("MoDest", fields: [destWarehouseId], references: [id])
  wipWarehouseId    Int?
  wipWarehouse      Warehouse?                @relation("MoWip", fields: [wipWarehouseId], references: [id])
  scrapWarehouseId  Int?
  scrapWarehouse    Warehouse?                @relation("MoScrap", fields: [scrapWarehouseId], references: [id])
  createdById       Int?
  createdBy      User?                     @relation("ManufacturingCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([companyId, name])
  @@index([companyId, state])
}

model JobCard {
  id            Int          @id @default(autoincrement())
  companyId     Int
  company       Company      @relation(fields: [companyId], references: [id])
  orderId       Int
  order         ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name          String
  sequence      Int
  operationName String
  workstationId Int?
  workstation   Workstation? @relation(fields: [workstationId], references: [id])
  plannedQty    Float
  completedQty  Float        @default(0)
  processLoss   Float        @default(0)
  rejectedQty   Float        @default(0)
  /// pending, open, done
  status        String
  logs          JobTimeLog[]
  wastage       WastageEntry[]

  @@unique([companyId, name])
  @@index([orderId])
}

model JobTimeLog {
  id           Int      @id @default(autoincrement())
  jobCardId    Int
  jobCard      JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  operatorName String
  minutes      Float
  note         String?
}

model WastageEntry {
  id            Int           @id @default(autoincrement())
  companyId     Int
  company       Company       @relation(fields: [companyId], references: [id])
  orderId       Int?
  order         ManufacturingOrder? @relation(fields: [orderId], references: [id])
  jobCardId     Int?
  jobCard       JobCard?      @relation(fields: [jobCardId], references: [id])
  productId     Int
  product       Product       @relation(fields: [productId], references: [id])
  workstationId Int?
  workstation   Workstation?  @relation(fields: [workstationId], references: [id])
  operationName String?
  quantity      Float
  reason        String
  /// process_loss, scrap, or rejected
  kind          String
  cost          Float
  expectedQty   Float         @default(0)
  createdAt     DateTime      @default(now())

  @@index([companyId, kind])
}

model ProductionPlan {
  id        Int                  @id @default(autoincrement())
  companyId Int
  company   Company              @relation(fields: [companyId], references: [id])
  name      String
  /// draft or raised
  state     String
  lines     ProductionPlanLine[]
  createdAt DateTime             @default(now())

  @@unique([companyId, name])
}

model ProductionPlanLine {
  id                Int            @id @default(autoincrement())
  planId            Int
  plan              ProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  productId         Int
  demandQty         Float
  onHand            Float
  toMake            Float
  toBuy             Float
  bomId             Int?
  workOrderId       Int?
  materialRequestId Int?
}

model ManufacturingComponent {
  id        Int                 @id @default(autoincrement())
  orderId   Int
  order     ManufacturingOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product             @relation(fields: [productId], references: [id])
  /// Total component quantity for the full order.
  quantity    Float
  consumed    Float               @default(0)
  lossPercent Float               @default(0)
}

model Warehouse {
  id            Int                  @id @default(autoincrement())
  name          String
  code          String
  isDefault     Boolean              @default(false)
  companyId     Int
  company       Company              @relation(fields: [companyId], references: [id])
  locations     StockLocation[]
  salesOrders   SalesOrder[]
  purchases     PurchaseOrder[]
  moSources     ManufacturingOrder[] @relation("MoSource")
  moDestinations ManufacturingOrder[] @relation("MoDest")
  moWip         ManufacturingOrder[] @relation("MoWip")
  moScrap       ManufacturingOrder[] @relation("MoScrap")
  reorderRules  ReorderRule[]
  posSessions   PosSession[]
  posOrders     PosOrder[]
  onlineFor     Company[]            @relation("CompanyOnlineWarehouse")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([companyId, code])
}

model StockLocation {
  id            Int                 @id @default(autoincrement())
  name          String
  /// internal, customer, supplier, inventory, production, or subcontract
  type          String
  vendorId      Int?
  vendor        Contact?            @relation("SubcontractVendor", fields: [vendorId], references: [id])
  subcontractOrders SubcontractOrder[]
  isDefault     Boolean             @default(false)
  companyId     Int
  company       Company             @relation(fields: [companyId], references: [id])
  warehouseId   Int?
  warehouse     Warehouse?          @relation(fields: [warehouseId], references: [id])
  quants        StockQuant[]
  movesFrom     StockMove[]         @relation("MoveFrom")
  movesTo       StockMove[]         @relation("MoveTo")
  transfersFrom StockTransfer[]     @relation("TransferFrom")
  transfersTo   StockTransfer[]     @relation("TransferTo")
  serials       StockSerial[]

  @@index([companyId, type])
  @@index([warehouseId])
}

model ReorderRule {
  id          Int       @id @default(autoincrement())
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id])
  minQty      Float
  maxQty      Float

  @@unique([productId, warehouseId])
}

model StockTransfer {
  id             Int                 @id @default(autoincrement())
  name           String
  /// draft, ready, done, cancel
  state          String
  companyId      Int
  company        Company             @relation(fields: [companyId], references: [id])
  locationFromId Int
  locationFrom   StockLocation       @relation("TransferFrom", fields: [locationFromId], references: [id])
  locationToId   Int
  locationTo     StockLocation       @relation("TransferTo", fields: [locationToId], references: [id])
  lines          StockTransferLine[]
  moves          StockMove[]
  createdById    Int?
  createdBy      User?               @relation("TransferCreatedBy", fields: [createdById], references: [id])
  routeId        Int?
  route          StockRoute?         @relation(fields: [routeId], references: [id])
  /// Current step on a multi-step route. Empty when the transfer has no route.
  step           String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([companyId, name])
  @@index([companyId, state])
}

model StockTransferLine {
  id         Int           @id @default(autoincrement())
  transferId Int
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Float
  lotName    String?
}

model StockQuant {
  id         Int           @id @default(autoincrement())
  productId  Int
  product    Product       @relation(fields: [productId], references: [id])
  locationId Int
  location   StockLocation @relation(fields: [locationId], references: [id])
  quantity   Float

  @@unique([productId, locationId])
}

model StockMove {
  id             Int           @id @default(autoincrement())
  productId      Int
  product        Product       @relation(fields: [productId], references: [id])
  locationFromId Int
  locationFrom   StockLocation @relation("MoveFrom", fields: [locationFromId], references: [id])
  locationToId   Int
  locationTo     StockLocation @relation("MoveTo", fields: [locationToId], references: [id])
  quantity       Float
  state          String
  reference       String
  lotName         String?
  orderId         Int?
  order           SalesOrder?    @relation(fields: [orderId], references: [id])
  purchaseOrderId      Int?
  purchaseOrder        PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  manufacturingOrderId Int?
  manufacturingOrder   ManufacturingOrder? @relation(fields: [manufacturingOrderId], references: [id])
  transferId           Int?
  transfer             StockTransfer?      @relation(fields: [transferId], references: [id])
  posOrderId           Int?
  posOrder             PosOrder?           @relation(fields: [posOrderId], references: [id])
  deliveryNoteId       Int?
  deliveryNote         DeliveryNote?       @relation(fields: [deliveryNoteId], references: [id])
  purchaseReceiptId    Int?
  purchaseReceipt      PurchaseReceipt?    @relation(fields: [purchaseReceiptId], references: [id])
  subcontractOrderId   Int?
  subcontractOrder     SubcontractOrder?   @relation(fields: [subcontractOrderId], references: [id])
  /// When set on a receipt, this unit cost is used instead of the product cost.
  unitCost             Float?
  date                 DateTime
}

model PosSession {
  id           Int        @id @default(autoincrement())
  name         String
  /// open or closed
  state        String
  warehouseId  Int
  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id])
  companyId    Int
  company      Company    @relation(fields: [companyId], references: [id])
  openingCash  Float
  closingCash  Float?
  /// Counted cash minus expected cash. Empty while the session is open.
  difference   Float?
  note         String?
  openedById   Int
  openedBy     User       @relation("PosOpenedBy", fields: [openedById], references: [id])
  closedById   Int?
  closedBy     User?      @relation("PosClosedBy", fields: [closedById], references: [id])
  openedAt     DateTime   @default(now())
  closedAt     DateTime?
  orders       PosOrder[]

  @@unique([companyId, name])
  @@index([companyId, state])
  @@index([warehouseId, state])
}

model PosOrder {
  id             Int            @id @default(autoincrement())
  name           String
  /// paid, partial, or refunded
  state          String
  sessionId      Int
  session        PosSession     @relation(fields: [sessionId], references: [id])
  companyId      Int
  company        Company        @relation(fields: [companyId], references: [id])
  warehouseId    Int
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])
  customerId     Int?
  customer       Contact?       @relation(fields: [customerId], references: [id])
  amountUntaxed  Float
  amountTax      Float
  amountTotal    Float
  amountRefunded Float          @default(0)
  lines          PosOrderLine[]
  payments       PosPayment[]
  moves          StockMove[]
  invoices       Invoice[]
  createdById    Int
  createdBy      User           @relation("PosOrderCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())

  @@unique([companyId, name])
  @@index([companyId, createdAt])
  @@index([sessionId])
}

model PosOrderLine {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  description String
  quantity    Float
  refundedQty Float    @default(0)
  unitPrice   Float
  discount    Float    @default(0)
  taxRate     Float
  subtotal    Float
  taxAmount   Float
}

model PosPayment {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// cash, card, wechat, or alipay
  method    String
  /// payment or refund
  direction String
  /// Amount applied to the sale, or given back on a refund.
  amount    Float
  tendered  Float?
  change    Float?
  createdAt DateTime @default(now())
}

model Account {
  id        Int           @id @default(autoincrement())
  code      String
  name      String
  /// asset, liability, equity, income, expense
  type      String
  companyId Int
  company   Company       @relation(fields: [companyId], references: [id])
  items     JournalItem[]
  assetCategories AssetCategory[] @relation("AssetAccount")
  accumCategories AssetCategory[] @relation("AccumAccount")
  expenseCategories AssetCategory[] @relation("DepExpenseAccount")

  @@unique([companyId, code])
}

model Journal {
  id        Int            @id @default(autoincrement())
  code      String
  name      String
  companyId Int
  company   Company        @relation(fields: [companyId], references: [id])
  entries   JournalEntry[]

  @@unique([companyId, code])
}

model Invoice {
  id              Int              @id @default(autoincrement())
  name            String
  /// out_invoice, out_refund, in_invoice, in_refund
  moveType        String
  /// draft, posted, paid, cancel
  state           String
  partnerId       Int
  partner         Contact          @relation(fields: [partnerId], references: [id])
  companyId       Int
  company         Company          @relation(fields: [companyId], references: [id])
  invoiceDate     DateTime
  salesOrderId    Int?
  salesOrder      SalesOrder?      @relation(fields: [salesOrderId], references: [id])
  purchaseOrderId Int?
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  posOrderId      Int?
  posOrder        PosOrder?        @relation(fields: [posOrderId], references: [id])
  reversalOfId    Int?
  reversalOf      Invoice?         @relation("InvoiceReversal", fields: [reversalOfId], references: [id])
  reversals       Invoice[]        @relation("InvoiceReversal")
  amountUntaxed   Float
  amountTax       Float
  amountTotal     Float
  residual        Float
  buyerName       String?
  buyerTaxId      String?
  buyerAddress    String?
  fapiaoNumber    String?
  /// special, general, or electronic
  fapiaoType      String?
  /// none or ready. Never submitted to a Golden Tax platform.
  fapiaoStatus    String           @default("none")
  /// Percent of the untaxed amount added by a charges template. Zero means no charge.
  chargeRate      Float            @default(0)
  chargeAmount    Float            @default(0)
  costCentreId    Int?
  costCentre      CostCentre?      @relation(fields: [costCentreId], references: [id])
  lines           InvoiceLine[]
  payments        InvoicePayment[]
  entries         JournalEntry[]
  matches         ReconcileMatch[]
  subcontractReceipts SubcontractReceipt[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([companyId, name])
  @@index([companyId, state])
  @@index([companyId, moveType])
  @@index([companyId, invoiceDate])
  @@index([companyId, state, moveType])
}

model InvoiceLine {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float
  subtotal    Float
  taxAmount   Float
  salesOrderLineId    Int?
  salesOrderLine      SalesOrderLine?    @relation(fields: [salesOrderLineId], references: [id])
  purchaseOrderLineId Int?
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  asset               Asset?
}

model InvoicePayment {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  /// bank, cash, wechat, alipay, card
  method    String
  paidAt    DateTime @default(now())
}

model JournalEntry {
  id        Int           @id @default(autoincrement())
  name      String
  journalId Int
  journal   Journal       @relation(fields: [journalId], references: [id])
  invoiceId Int?
  invoice   Invoice?      @relation(fields: [invoiceId], references: [id])
  date      DateTime
  companyId Int
  company   Company       @relation(fields: [companyId], references: [id])
  lines     JournalItem[]
  payrollRun PayrollRun?
  expenseClaim ExpenseClaim?
  depreciation AssetDepreciation?
  disposedAssets Asset[] @relation("AssetDisposal")
  valuations   ValuationLayer[]

  @@unique([companyId, name])
  @@index([companyId, date])
}

model JournalItem {
  id        Int          @id @default(autoincrement())
  entryId   Int
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId Int
  account   Account      @relation(fields: [accountId], references: [id])
  partnerId Int?
  label     String
  debit     Float        @default(0)
  credit    Float        @default(0)
  costCentreId Int?
  costCentre   CostCentre? @relation(fields: [costCentreId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@index([costCentreId])
}

model FiscalYear {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  startsOn  DateTime
  endsOn    DateTime
  closed    Boolean  @default(false)

  @@unique([companyId, name])
}

model CostCentre {
  id        Int           @id @default(autoincrement())
  companyId Int
  company   Company       @relation(fields: [companyId], references: [id])
  code      String
  name      String
  invoices  Invoice[]
  items     JournalItem[]

  @@unique([companyId, code])
}

model ChargeTemplate {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  /// sales or purchase
  side      String
  /// Percent of the untaxed amount.
  rate      Float

  @@unique([companyId, name])
}

model StockLedger {
  id           Int      @id @default(autoincrement())
  companyId    Int
  company      Company  @relation(fields: [companyId], references: [id])
  productId    Int
  product      Product  @relation(fields: [productId], references: [id])
  moveId       Int?
  qtyIn        Float    @default(0)
  qtyOut       Float    @default(0)
  value        Float
  balanceQty   Float
  balanceValue Float
  createdAt    DateTime @default(now())

  @@index([companyId, productId])
}

model StockBatch {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  name      String
  quantity  Float   @default(0)

  @@unique([companyId, productId, name])
}

model StockSerial {
  id         Int            @id @default(autoincrement())
  companyId  Int
  company    Company        @relation(fields: [companyId], references: [id])
  productId  Int
  product    Product        @relation(fields: [productId], references: [id])
  name       String
  locationId Int?
  location   StockLocation? @relation(fields: [locationId], references: [id])
  /// in_stock or issued
  state      String

  @@unique([companyId, name])
}

model Lead {
  id               Int        @id @default(autoincrement())
  name             String
  contactName      String
  email            String?
  phone            String?
  expectedRevenue  Float      @default(0)
  /// new, qualified, proposition, won, lost
  stage            String
  companyId        Int
  company          Company    @relation(fields: [companyId], references: [id])
  userId           Int?
  user             User?      @relation(fields: [userId], references: [id])
  contactId        Int?
  contact          Contact?   @relation(fields: [contactId], references: [id])
  orderId          Int?
  activities       Activity[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([companyId, stage])
}

model Activity {
  id        Int       @id @default(autoincrement())
  leadId    Int
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// call, meeting, todo
  kind      String
  summary   String
  dueOn     DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String
  companyId Int
  company   Company    @relation(fields: [companyId], references: [id])
  employees Employee[]
  createdAt DateTime   @default(now())

  @@unique([companyId, name])
}

model Employee {
  id           Int          @id @default(autoincrement())
  name         String
  email        String?
  phone        String?
  jobTitle     String?
  active       Boolean      @default(true)
  departmentId Int?
  department   Department?  @relation(fields: [departmentId], references: [id])
  companyId    Int
  company      Company      @relation(fields: [companyId], references: [id])
  attendances  Attendance[]
  leaves       LeaveRequest[]
  salary       SalaryStructure?
  payslips     Payslip[]
  expenses     ExpenseClaim[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([companyId])
}

model Attendance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate   DateTime
  /// present, absent, late
  status     String
  note       String?
  createdAt  DateTime @default(now())

  @@unique([employeeId, workDate])
}

model LeaveRequest {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// annual, sick, personal
  kind       String
  dateFrom   DateTime
  dateTo     DateTime
  /// draft, approved, refused
  state      String   @default("draft")
  reason     String?
  createdAt  DateTime @default(now())

  @@index([employeeId, state])
}

/// One monthly gross per employee. Deduction maths is a demo approximation.
model SalaryStructure {
  id            Int      @id @default(autoincrement())
  companyId     Int
  company       Company  @relation(fields: [companyId], references: [id])
  employeeId    Int      @unique
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  monthlyGross  Float
  createdAt     DateTime @default(now())

  @@index([companyId])
}

model PayrollRun {
  id         Int          @id @default(autoincrement())
  name       String
  /// YYYY-MM
  period     String
  /// draft, posted, paid
  state      String
  companyId  Int
  company    Company      @relation(fields: [companyId], references: [id])
  payslips   Payslip[]
  entryId    Int?         @unique
  entry      JournalEntry? @relation(fields: [entryId], references: [id])
  createdAt  DateTime     @default(now())

  @@unique([companyId, name])
  @@index([companyId, period])
}

model Payslip {
  id          Int          @id @default(autoincrement())
  runId       Int
  run         PayrollRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee     @relation(fields: [employeeId], references: [id])
  gross       Float
  deduction   Float
  net         Float
  lines       PayslipLine[]

  @@unique([runId, employeeId])
}

model PayslipLine {
  id        Int     @id @default(autoincrement())
  payslipId Int
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  code      String
  label     String
  /// earning or deduction
  kind      String
  amount    Float
}

model DeskRecord {
  id         Int      @id @default(autoincrement())
  companyId  Int
  company    Company  @relation(fields: [companyId], references: [id])
  module     String
  screen     String
  name       String
  state      String   @default("draft")
  partner    String   @default("")
  owner      String   @default("")
  bucket     String   @default("")
  amount     Float    @default(0)
  notes      String   @default("")
  recordDate DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([companyId, module, screen, name])
  @@index([companyId, module, screen])
  @@index([companyId, module, screen, state])
  @@index([companyId, recordDate])
}

model ModuleSetting {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  module    String
  key       String
  value     String

  @@unique([companyId, module, key])
}

model ExpenseClaim {
  id          Int           @id @default(autoincrement())
  name        String
  companyId   Int
  company     Company       @relation(fields: [companyId], references: [id])
  employeeId  Int
  employee    Employee      @relation(fields: [employeeId], references: [id])
  merchant    String
  description String
  /// A receipt reference. The file itself is not stored.
  receiptRef  String
  amount      Float
  spentOn     DateTime
  /// submitted, approved, reimbursed, refused
  state       String
  entryId     Int?          @unique
  entry       JournalEntry? @relation(fields: [entryId], references: [id])
  createdAt   DateTime      @default(now())

  @@unique([companyId, name])
  @@index([companyId, state])
}

model AccessGroup {
  id        Int           @id @default(autoincrement())
  companyId Int
  company   Company       @relation(fields: [companyId], references: [id])
  key       String
  name      String
  members   GroupMember[]
  grants    ModelAccess[]
  rules     RecordRule[]

  @@unique([companyId, key])
}

model GroupMember {
  id      Int         @id @default(autoincrement())
  groupId Int
  group   AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  Int
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model ModelAccess {
  id        Int         @id @default(autoincrement())
  groupId   Int
  group     AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  model     String
  canRead   Boolean     @default(false)
  canWrite  Boolean     @default(false)
  canCreate Boolean     @default(false)
  canDelete Boolean     @default(false)

  @@unique([groupId, model])
}

model RecordRule {
