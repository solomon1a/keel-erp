generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Company {
  id             Int             @id @default(autoincrement())
  name           String
  city           String
  /// ISO 4217 code. One currency on the company until a later multi-currency slice.
  currency       String          @default("CNY")
  defaultTaxRate Float           @default(13)
  users     User[]
  contacts  Contact[]
  products  Product[]
  orders        SalesOrder[]
  purchases     PurchaseOrder[]
  boms          BillOfMaterials[]
  manufacturing ManufacturingOrder[]
  workstations  Workstation[]
  jobCards      JobCard[]
  wastageEntries WastageEntry[]
  productionPlans ProductionPlan[]
  warehouses    Warehouse[]
  transfers     StockTransfer[]
  reorderRules  ReorderRule[]
  locations     StockLocation[]
  categories    ProductCategory[]
  posSessions   PosSession[]
  posOrders     PosOrder[]
  shopCustomers ShopCustomer[]
  accounts      Account[]
  journals      Journal[]
  invoices      Invoice[]
  entries       JournalEntry[]
  fiscalYears   FiscalYear[]
  costCentres   CostCentre[]
  chargeTemplates ChargeTemplate[]
  stockLedgers  StockLedger[]
  stockBatches  StockBatch[]
  stockSerials  StockSerial[]
  leads         Lead[]
  departments   Department[]
  employees     Employee[]
  salaryStructures SalaryStructure[]
  payrollRuns   PayrollRun[]
  expenses      ExpenseClaim[]
  deskRecords   DeskRecord[]
  moduleSettings ModuleSetting[]
  /// Seller taxpayer ID printed on invoices. Not a Golden Tax registration.
  taxId         String?
  address       String?
  /// No journal, payment, or stock valuation is posted on or before this date.
  lockDate      DateTime?
  taxLockDate   DateTime?
  accessGroups  AccessGroup[]
  savedFilters  SavedFilter[]
  chatter       ChatterMessage[]
  statements    BankStatement[]
  valuations    ValuationLayer[]
  routes        StockRoute[]
  customerGroups CustomerGroup[]
  priceLists     PriceList[]
  pricingRules   PricingRule[]
  quotations     Quotation[]
  deliveryNotes  DeliveryNote[]
  receipts       PurchaseReceipt[]
  materialRequests MaterialRequest[]
  supplierQuotes SupplierQuotation[]
  demoRuns       DemoRun[]
  exchangeRates  ExchangeRate[]
  assetCategories AssetCategory[]
  assets         Asset[]
  subcontractOrders SubcontractOrder[]
  invites        UserInvite[]
  qualityPoints  QualityPoint[]
  qualityChecks  QualityCheck[]
  qualityAlerts  QualityAlert[]
  projects       Project[]
  bankAccounts   BankAccount[]
  reconcileRules ReconcileRule[]
  /// Public website address, /site/<slug>. Empty until the company publishes.
  slug           String?         @unique
  mailLists      MailList[]
  mailTemplates  MailTemplate[]
  campaigns      Campaign[]
  mailSuppressions MailSuppression[]
  siteTheme      SiteTheme?
  siteMenus      SiteMenuItem[]
  sitePages      SitePage[]
  blogPosts      BlogPost[]
  siteSubmissions SiteSubmission[]
  paymentTerms     PaymentTerm[]
  followUpLevels   FollowUpLevel[]
  companyTaxes     CompanyTax[]
  taxGroups        TaxGroup[]
  fiscalPositions  FiscalPosition[]
  recurringInvoices RecurringInvoice[]
  mailLogs         MailLog[]
  fileBlobs        FileBlob[]
  documentTaxes    DocumentTax[]
  helpdeskTeams    HelpdeskTeam[]
  helpdeskTags     HelpdeskTag[]
  slaPolicies      SlaPolicy[]
  tickets          Ticket[]
  /// Warehouse that fills online orders. Empty uses the default warehouse.
  onlineWarehouseId Int?
  onlineWarehouse   Warehouse? @relation("CompanyOnlineWarehouse", fields: [onlineWarehouseId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model User {
  id              Int          @id @default(autoincrement())
  name            String
  email           String       @unique
  passwordHash    String
  role            String
  companyId       Int
  company         Company      @relation(fields: [companyId], references: [id])
  sessions        Session[]
  createdContacts Contact[]    @relation("ContactCreatedBy")
  updatedContacts Contact[]    @relation("ContactUpdatedBy")
  createdOrders    SalesOrder[]    @relation("OrderCreatedBy")
  createdPurchases     PurchaseOrder[]     @relation("PurchaseCreatedBy")
  createdManufacturing ManufacturingOrder[] @relation("ManufacturingCreatedBy")
  createdTransfers     StockTransfer[]     @relation("TransferCreatedBy")
  openedSessions       PosSession[]        @relation("PosOpenedBy")
  closedSessions       PosSession[]        @relation("PosClosedBy")
  posOrders            PosOrder[]          @relation("PosOrderCreatedBy")
  leads                Lead[]
  memberships          GroupMember[]
  savedFilters         SavedFilter[]
  chatter              ChatterMessage[]
  demoRuns             DemoRun[]
  invitesSent          UserInvite[]
  /// ISO code used only to format amounts. Empty follows the company currency. The books stay in that currency.
  displayCurrency      String?
  qualityOverrides     QualityCheck[]      @relation("QualityOverride")
  assignedTickets      Ticket[]            @relation("TicketAssignee")
  createdAt            DateTime            @default(now())
}

/// How many units of `currency` equal one unit of the company currency. A demo table until an admin edits it.
model ExchangeRate {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  currency  String
  rate      Float

  @@unique([companyId, currency])
  @@index([companyId])
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Country {
  id       Int       @id @default(autoincrement())
  name     String
  code     String    @unique
  contacts Contact[]
}

model Contact {
  id          Int          @id @default(autoincrement())
  name        String
  email       String?
  phone       String?
  isCompany   Boolean      @default(false)
  isCustomer  Boolean      @default(false)
  isSupplier  Boolean      @default(false)
  isEmployee  Boolean      @default(false)
  street      String?
  city        String?
  state       String?
  postalCode  String?
  /// Buyer taxpayer identification number for a fapiao-ready invoice.
  taxId       String?
  /// Zero means the customer is not held to a credit limit.
  creditLimit Float        @default(0)
  customerGroupId Int?
  customerGroup   CustomerGroup? @relation(fields: [customerGroupId], references: [id])
  notes       String?
  subcontracts ManufacturingOrder[] @relation("MoSupplier")
  parentId    Int?
  parent      Contact?     @relation("ContactHierarchy", fields: [parentId], references: [id])
  children    Contact[]    @relation("ContactHierarchy")
  countryId   Int?
  country     Country?     @relation(fields: [countryId], references: [id])
  companyId      Int
  company        Company         @relation(fields: [companyId], references: [id])
  orders         SalesOrder[]
  purchaseOrders PurchaseOrder[]
  posOrders      PosOrder[]
  shopCustomers  ShopCustomer[]
  invoices       Invoice[]
  tickets        Ticket[]
  quotations     Quotation[]
  supplierQuotes SupplierQuotation[]
  subcontractLocations StockLocation[] @relation("SubcontractVendor")
  subcontractOrders SubcontractOrder[] @relation("SubcontractVendor")
  customerRules  PricingRule[] @relation("RuleCustomer")
  vendorRules    PricingRule[] @relation("RuleVendor")
  leads          Lead[]
  mailMembers    MailMember[]
  qualityChecks  QualityCheck[]  @relation("QualityVendor")
  qualityAlerts  QualityAlert[]  @relation("AlertVendor")
  projects       Project[]
  salePriceListId Int?
  salePriceList   PriceList? @relation("SaleList", fields: [salePriceListId], references: [id])
  purchasePriceListId Int?
  purchasePriceList   PriceList? @relation("BuyList", fields: [purchasePriceListId], references: [id])
  paymentTermId Int?
  paymentTerm   PaymentTerm? @relation(fields: [paymentTermId], references: [id])
  fiscalPositionId Int?
  fiscalPosition   FiscalPosition? @relation(fields: [fiscalPositionId], references: [id])
  recurringInvoices RecurringInvoice[]
  createdAt      DateTime        @default(now())
  updatedAt   DateTime     @updatedAt
  createdById Int?
  updatedById Int?
  createdBy   User?        @relation("ContactCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?        @relation("ContactUpdatedBy", fields: [updatedById], references: [id])

  @@index([companyId, name])
}

model Tax {
  id             Int                 @id @default(autoincrement())
  name           String
  rate           Float
  isDefault      Boolean             @default(false)
  lines          SalesOrderLine[]
  purchaseLines  PurchaseOrderLine[]
}

model Product {
  id           Int                 @id @default(autoincrement())
  name         String
  sku          String
  /// `product` (stocked) or `service`.
  type         String
  /// `finished` goods or `raw` material. Services stay `finished`.
  kind         String              @default("finished")
  listPrice    Float
  costPrice    Float               @default(0)
  /// `fifo` or `avco`. Receipts and issues post a valuation layer.
  costMethod   String              @default("avco")
  purchasable  Boolean             @default(false)
  /// `none`, `lot`, or `serial`. The number is recorded on the stock move.
  tracking     String              @default("none")
  description  String?
  active       Boolean             @default(true)
  companyId    Int
  company      Company             @relation(fields: [companyId], references: [id])
  lines                    SalesOrderLine[]
  purchaseLines            PurchaseOrderLine[]
  boms                     BillOfMaterials[]        @relation("BomFinished")
  subcontractFinished      SubcontractOrder[]       @relation("SubFinished")
  subcontractParts         SubcontractComponent[]
  bomLines                 BomLine[]
  bomByproducts            BomByproduct[]           @relation("BomByproduct")
  wastageEntries           WastageEntry[]
  manufacturingOrders      ManufacturingOrder[]
  manufacturingComponents  ManufacturingComponent[]
  quants                   StockQuant[]
  moves                    StockMove[]
  reorderRules             ReorderRule[]
  transferLines            StockTransferLine[]
  categoryId   Int?
  category     ProductCategory?    @relation(fields: [categoryId], references: [id])
  /// Shop barcode. Empty products are not looked up from the register scanner.
  barcode      String?
  /// Shown on the public shop. Raw materials stay off unless someone publishes them.
  websitePublished Boolean          @default(false)
  posLines     PosOrderLine[]
  valuations   ValuationLayer[]
  ledgers      StockLedger[]
  batches      StockBatch[]
  serials      StockSerial[]
  priceItems   PriceListItem[]
  pricingRules PricingRule[]
  qualityPoints QualityPoint[]
  qualityChecks QualityCheck[]
  qualityAlerts QualityAlert[] @relation("AlertProduct")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([categoryId])
}

model ProductCategory {
  id        Int       @id @default(autoincrement())
  name      String
  companyId Int
  company   Company   @relation(fields: [companyId], references: [id])
  products  Product[]

  @@unique([companyId, name])
}

model ShopCustomer {
  id           Int           @id @default(autoincrement())
  name         String
  email        String
  passwordHash String
  phone        String?
  contactId    Int
  contact      Contact       @relation(fields: [contactId], references: [id])
  companyId    Int
  company      Company       @relation(fields: [companyId], references: [id])
  sessions     ShopSession[]
  createdAt    DateTime      @default(now())

  @@unique([companyId, email])
}

model ShopSession {
  id         Int          @id @default(autoincrement())
  tokenHash  String       @unique
  customerId Int
  customer   ShopCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime     @default(now())

  @@index([customerId])
}

model Sequence {
  id   Int    @id @default(autoincrement())
  name String @unique
  next Int    @default(0)
}

model SalesOrder {
  id            Int              @id @default(autoincrement())
  name          String
  state         String
  customerId    Int
  customer      Contact          @relation(fields: [customerId], references: [id])
  companyId     Int
  company       Company          @relation(fields: [companyId], references: [id])
  dateOrder     DateTime
  validityDate  DateTime?
  amountUntaxed Float
  amountTax     Float
  amountTotal   Float
  lines         SalesOrderLine[]
  moves         StockMove[]
  invoices      Invoice[]
  quotations    Quotation[]
  deliveries    DeliveryNote[]
  manufacturingOrders ManufacturingOrder[]
  qualityChecks QualityCheck[]
  warehouseId   Int?
  warehouse     Warehouse?       @relation(fields: [warehouseId], references: [id])
  /// `desk` or `shop`.
  origin        String           @default("desk")
  /// `wechat`, `alipay`, or `card` when the order came from the shop. Recorded only.
  paymentMethod String?
  /// `recorded` when a shop payment was stored. No gateway capture.
  paymentState  String?
  publicToken   String?          @unique
  createdById   Int?
  createdBy     User?            @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([companyId, name])
  @@index([companyId, state])
  @@index([companyId, dateOrder])
  @@index([companyId, updatedAt])
}

model SalesOrderLine {
  id        Int         @id @default(autoincrement())
  orderId   Int
  order     SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product     @relation(fields: [productId], references: [id])
  description String
  quantity  Float
  unitPrice Float
  discount  Float       @default(0)
  taxId     Int?
  tax       Tax?        @relation(fields: [taxId], references: [id])
  subtotal  Float
  taxAmount Float
  qtyDelivered Float @default(0)
  qtyInvoiced  Float @default(0)
  deliveryLines DeliveryNoteLine[]
  invoiceLines  InvoiceLine[]
}

model PurchaseOrder {
  id            Int                 @id @default(autoincrement())
  name          String
  /// draft (RFQ), sent, purchase (confirmed), done (received), cancel
  state         String
  vendorId      Int
  vendor        Contact             @relation(fields: [vendorId], references: [id])
  companyId     Int
  company       Company             @relation(fields: [companyId], references: [id])
  dateOrder     DateTime
  amountUntaxed Float
  amountTax     Float
  amountTotal   Float
  lines         PurchaseOrderLine[]
  moves         StockMove[]
  invoices      Invoice[]
  receipts      PurchaseReceipt[]
  quotes        SupplierQuotation[]
  qualityChecks QualityCheck[]
  warehouseId   Int?
  warehouse     Warehouse?          @relation(fields: [warehouseId], references: [id])
  createdById   Int?
  createdBy     User?               @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([companyId, name])
  @@index([companyId, state])
  @@index([companyId, dateOrder])
}

model PurchaseOrderLine {
  id          Int           @id @default(autoincrement())
  orderId     Int
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product       @relation(fields: [productId], references: [id])
  description String
  quantity    Float
  unitCost    Float
  taxId       Int?
  tax         Tax?          @relation(fields: [taxId], references: [id])
  subtotal    Float
  taxAmount   Float
  qtyReceived Float         @default(0)
  qtyBilled   Float         @default(0)
  receiptLines PurchaseReceiptLine[]
  invoiceLines InvoiceLine[]
}

model BillOfMaterials {
  id         Int                  @id @default(autoincrement())
  productId  Int
  product    Product              @relation("BomFinished", fields: [productId], references: [id])
  companyId  Int
  company    Company              @relation(fields: [companyId], references: [id])
  /// Finished units this recipe makes. Component quantities are for this many units.
  yieldQty   Float                @default(1)
  version    Int                  @default(1)
  active     Boolean              @default(true)
  notes      String?
  lines      BomLine[]
  operations BomOperation[]
  byproducts BomByproduct[]
  orders     ManufacturingOrder[]
  subcontractOrders SubcontractOrder[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([productId, version])
  @@index([companyId, active])
}

model BomLine {
  id          Int             @id @default(autoincrement())
  bomId       Int
  bom         BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product         @relation(fields: [productId], references: [id])
  quantity    Float
  lossPercent Float           @default(0)
}

model Workstation {
  id        Int            @id @default(autoincrement())
  companyId Int
  company   Company        @relation(fields: [companyId], references: [id])
  name      String
  hourRate  Float
  operations BomOperation[]
  jobCards  JobCard[]
  wastage   WastageEntry[]

  @@unique([companyId, name])
}

model BomOperation {
  id            Int             @id @default(autoincrement())
  bomId         Int
  bom           BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  sequence      Int
  name          String
  workstationId Int
  workstation   Workstation     @relation(fields: [workstationId], references: [id])
  hours         Float
  lossPercent   Float           @default(0)
}

model BomByproduct {
  id        Int             @id @default(autoincrement())
  bomId     Int
  bom       BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  productId Int
  product   Product         @relation("BomByproduct", fields: [productId], references: [id])
  quantity  Float
}

model ManufacturingOrder {
  id             Int                       @id @default(autoincrement())
  name           String
  /// draft, confirmed, progress, done, cancel
  state          String
  productId      Int
  product        Product                   @relation(fields: [productId], references: [id])
  bomId          Int
  bom            BillOfMaterials           @relation(fields: [bomId], references: [id])
  companyId      Int
  company        Company                   @relation(fields: [companyId], references: [id])
  quantity       Float
  quantityDone   Float                     @default(0)
  /// stock, order, or subcontract
  purpose             String                    @default("stock")
  salesOrderId        Int?
  salesOrder          SalesOrder?               @relation(fields: [salesOrderId], references: [id])
  materialRequestId   Int?
  materialRequest     MaterialRequest?          @relation(fields: [materialRequestId], references: [id])
  supplierId          Int?
  supplier            Contact?                  @relation("MoSupplier", fields: [supplierId], references: [id])
  subcontractState    String?
  transferred         Boolean                   @default(false)
  operatingAbsorbed   Float                     @default(0)
  relieved            Float                     @default(0)
  quantityRejected    Float                     @default(0)
  lines          ManufacturingComponent[]
  moves             StockMove[]
  jobCards          JobCard[]
  wastage           WastageEntry[]
  sourceWarehouseId Int?
  sourceWarehouse   Warehouse?                @relation("MoSource", fields: [sourceWarehouseId], references: [id])
  destWarehouseId   Int?
  destWarehouse     Warehouse?                @relation("MoDest", fields: [destWarehouseId], references: [id])
  wipWarehouseId    Int?
  wipWarehouse      Warehouse?                @relation("MoWip", fields: [wipWarehouseId], references: [id])
  scrapWarehouseId  Int?
  scrapWarehouse    Warehouse?                @relation("MoScrap", fields: [scrapWarehouseId], references: [id])
  qualityChecks  QualityCheck[]
  createdById       Int?
  createdBy      User?                     @relation("ManufacturingCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([companyId, name])
  @@index([companyId, state])
}

model JobCard {
  id            Int          @id @default(autoincrement())
  companyId     Int
  company       Company      @relation(fields: [companyId], references: [id])
  orderId       Int
  order         ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name          String
  sequence      Int
  operationName String
  workstationId Int?
  workstation   Workstation? @relation(fields: [workstationId], references: [id])
  plannedQty    Float
  completedQty  Float        @default(0)
  processLoss   Float        @default(0)
  rejectedQty   Float        @default(0)
  /// pending, open, done
  status        String
  logs          JobTimeLog[]
  wastage       WastageEntry[]

  @@unique([companyId, name])
  @@index([orderId])
}

model JobTimeLog {
  id           Int      @id @default(autoincrement())
  jobCardId    Int
  jobCard      JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  operatorName String
  minutes      Float
  note         String?
}

model WastageEntry {
  id            Int           @id @default(autoincrement())
  companyId     Int
  company       Company       @relation(fields: [companyId], references: [id])
  orderId       Int?
  order         ManufacturingOrder? @relation(fields: [orderId], references: [id])
  jobCardId     Int?
  jobCard       JobCard?      @relation(fields: [jobCardId], references: [id])
  productId     Int
  product       Product       @relation(fields: [productId], references: [id])
  workstationId Int?
  workstation   Workstation?  @relation(fields: [workstationId], references: [id])
  operationName String?
  quantity      Float
  reason        String
  /// process_loss, scrap, or rejected
  kind          String
  cost          Float
  expectedQty   Float         @default(0)
  createdAt     DateTime      @default(now())

  @@index([companyId, kind])
}

model ProductionPlan {
  id        Int                  @id @default(autoincrement())
  companyId Int
  company   Company              @relation(fields: [companyId], references: [id])
  name      String
  /// draft or raised
  state     String
  lines     ProductionPlanLine[]
  createdAt DateTime             @default(now())

  @@unique([companyId, name])
}

model ProductionPlanLine {
  id                Int            @id @default(autoincrement())
  planId            Int
  plan              ProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  productId         Int
  demandQty         Float
  onHand            Float
  toMake            Float
  toBuy             Float
  bomId             Int?
  workOrderId       Int?
  materialRequestId Int?
}

model ManufacturingComponent {
  id        Int                 @id @default(autoincrement())
  orderId   Int
  order     ManufacturingOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product             @relation(fields: [productId], references: [id])
  /// Total component quantity for the full order.
  quantity    Float
  consumed    Float               @default(0)
  lossPercent Float               @default(0)
}

model Warehouse {
  id            Int                  @id @default(autoincrement())
  name          String
  code          String
  isDefault     Boolean              @default(false)
  companyId     Int
  company       Company              @relation(fields: [companyId], references: [id])
  locations     StockLocation[]
  salesOrders   SalesOrder[]
  purchases     PurchaseOrder[]
  moSources     ManufacturingOrder[] @relation("MoSource")
  moDestinations ManufacturingOrder[] @relation("MoDest")
  moWip         ManufacturingOrder[] @relation("MoWip")
  moScrap       ManufacturingOrder[] @relation("MoScrap")
  reorderRules  ReorderRule[]
  posSessions   PosSession[]
  posOrders     PosOrder[]
  onlineFor     Company[]            @relation("CompanyOnlineWarehouse")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([companyId, code])
}

model StockLocation {
  id            Int                 @id @default(autoincrement())
  name          String
  /// internal, customer, supplier, inventory, production, subcontract, or quarantine
  type          String
  vendorId      Int?
  vendor        Contact?            @relation("SubcontractVendor", fields: [vendorId], references: [id])
  subcontractOrders SubcontractOrder[]
  isDefault     Boolean             @default(false)
  companyId     Int
  company       Company             @relation(fields: [companyId], references: [id])
  warehouseId   Int?
  warehouse     Warehouse?          @relation(fields: [warehouseId], references: [id])
  quants        StockQuant[]
  movesFrom     StockMove[]         @relation("MoveFrom")
  movesTo       StockMove[]         @relation("MoveTo")
  transfersFrom StockTransfer[]     @relation("TransferFrom")
  transfersTo   StockTransfer[]     @relation("TransferTo")
  serials       StockSerial[]

  @@index([companyId, type])
  @@index([warehouseId])
}

model ReorderRule {
  id          Int       @id @default(autoincrement())
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id])
  minQty      Float
  maxQty      Float

  @@unique([productId, warehouseId])
}

model StockTransfer {
  id             Int                 @id @default(autoincrement())
  name           String
  /// draft, ready, done, cancel
  state          String
  companyId      Int
  company        Company             @relation(fields: [companyId], references: [id])
  locationFromId Int
  locationFrom   StockLocation       @relation("TransferFrom", fields: [locationFromId], references: [id])
  locationToId   Int
  locationTo     StockLocation       @relation("TransferTo", fields: [locationToId], references: [id])
  lines          StockTransferLine[]
  moves          StockMove[]
  createdById    Int?
  createdBy      User?               @relation("TransferCreatedBy", fields: [createdById], references: [id])
  routeId        Int?
  route          StockRoute?         @relation(fields: [routeId], references: [id])
  /// Current step on a multi-step route. Empty when the transfer has no route.
  step           String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([companyId, name])
  @@index([companyId, state])
}

model StockTransferLine {
  id         Int           @id @default(autoincrement())
  transferId Int
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Float
  lotName    String?
}

model StockQuant {
  id         Int           @id @default(autoincrement())
  productId  Int
  product    Product       @relation(fields: [productId], references: [id])
  locationId Int
  location   StockLocation @relation(fields: [locationId], references: [id])
  quantity   Float

  @@unique([productId, locationId])
}

model StockMove {
  id             Int           @id @default(autoincrement())
  productId      Int
  product        Product       @relation(fields: [productId], references: [id])
  locationFromId Int
  locationFrom   StockLocation @relation("MoveFrom", fields: [locationFromId], references: [id])
  locationToId   Int
  locationTo     StockLocation @relation("MoveTo", fields: [locationToId], references: [id])
  quantity       Float
  state          String
  reference       String
  lotName         String?
  orderId         Int?
  order           SalesOrder?    @relation(fields: [orderId], references: [id])
  purchaseOrderId      Int?
  purchaseOrder        PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  manufacturingOrderId Int?
  manufacturingOrder   ManufacturingOrder? @relation(fields: [manufacturingOrderId], references: [id])
  transferId           Int?
  transfer             StockTransfer?      @relation(fields: [transferId], references: [id])
  posOrderId           Int?
  posOrder             PosOrder?           @relation(fields: [posOrderId], references: [id])
  deliveryNoteId       Int?
  deliveryNote         DeliveryNote?       @relation(fields: [deliveryNoteId], references: [id])
  purchaseReceiptId    Int?
  purchaseReceipt      PurchaseReceipt?    @relation(fields: [purchaseReceiptId], references: [id])
  subcontractOrderId   Int?
  subcontractOrder     SubcontractOrder?   @relation(fields: [subcontractOrderId], references: [id])
  /// When set on a receipt, this unit cost is used instead of the product cost.
  unitCost             Float?
  date                 DateTime
}

model PosSession {
  id           Int        @id @default(autoincrement())
  name         String
  /// open or closed
  state        String
  warehouseId  Int
  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id])
  companyId    Int
  company      Company    @relation(fields: [companyId], references: [id])
  openingCash  Float
  closingCash  Float?
  /// Counted cash minus expected cash. Empty while the session is open.
  difference   Float?
  note         String?
  openedById   Int
  openedBy     User       @relation("PosOpenedBy", fields: [openedById], references: [id])
  closedById   Int?
  closedBy     User?      @relation("PosClosedBy", fields: [closedById], references: [id])
  openedAt     DateTime   @default(now())
  closedAt     DateTime?
  orders       PosOrder[]

  @@unique([companyId, name])
  @@index([companyId, state])
  @@index([warehouseId, state])
}

model PosOrder {
  id             Int            @id @default(autoincrement())
  name           String
  /// paid, partial, or refunded
  state          String
  sessionId      Int
  session        PosSession     @relation(fields: [sessionId], references: [id])
  companyId      Int
  company        Company        @relation(fields: [companyId], references: [id])
  warehouseId    Int
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])
  customerId     Int?
  customer       Contact?       @relation(fields: [customerId], references: [id])
  amountUntaxed  Float
  amountTax      Float
  amountTotal    Float
  amountRefunded Float          @default(0)
  lines          PosOrderLine[]
  payments       PosPayment[]
  moves          StockMove[]
  invoices       Invoice[]
  createdById    Int
  createdBy      User           @relation("PosOrderCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())

  @@unique([companyId, name])
  @@index([companyId, createdAt])
  @@index([sessionId])
}

model PosOrderLine {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  description String
  quantity    Float
  refundedQty Float    @default(0)
  unitPrice   Float
  discount    Float    @default(0)
  taxRate     Float
  subtotal    Float
  taxAmount   Float
}

model PosPayment {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// cash, card, wechat, or alipay
  method    String
  /// payment or refund
  direction String
  /// Amount applied to the sale, or given back on a refund.
  amount    Float
  tendered  Float?
  change    Float?
  createdAt DateTime @default(now())
}

model Account {
  id        Int           @id @default(autoincrement())
  code      String
  name      String
  /// asset, liability, equity, income, expense
  type      String
  companyId Int
  company   Company       @relation(fields: [companyId], references: [id])
  items     JournalItem[]
  assetCategories AssetCategory[] @relation("AssetAccount")
  accumCategories AssetCategory[] @relation("AccumAccount")
  expenseCategories AssetCategory[] @relation("DepExpenseAccount")

  @@unique([companyId, code])
}

model Journal {
  id        Int            @id @default(autoincrement())
  code      String
  name      String
  companyId Int
  company   Company        @relation(fields: [companyId], references: [id])
  entries   JournalEntry[]

  @@unique([companyId, code])
}

model Invoice {
  id              Int              @id @default(autoincrement())
  name            String
  /// out_invoice, out_refund, in_invoice, in_refund
  moveType        String
  /// draft, posted, paid, cancel
  state           String
  partnerId       Int
  partner         Contact          @relation(fields: [partnerId], references: [id])
  companyId       Int
  company         Company          @relation(fields: [companyId], references: [id])
  invoiceDate     DateTime
  salesOrderId    Int?
  salesOrder      SalesOrder?      @relation(fields: [salesOrderId], references: [id])
  purchaseOrderId Int?
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  posOrderId      Int?
  posOrder        PosOrder?        @relation(fields: [posOrderId], references: [id])
  reversalOfId    Int?
  reversalOf      Invoice?         @relation("InvoiceReversal", fields: [reversalOfId], references: [id])
  reversals       Invoice[]        @relation("InvoiceReversal")
  amountUntaxed   Float
  amountTax       Float
  amountTotal     Float
  residual        Float
  buyerName       String?
  buyerTaxId      String?
  buyerAddress    String?
  fapiaoNumber    String?
  /// special, general, or electronic
  fapiaoType      String?
  /// none or ready. Never submitted to a Golden Tax platform.
  fapiaoStatus    String           @default("none")
  /// Percent of the untaxed amount added by a charges template. Zero means no charge.
  chargeRate      Float            @default(0)
  chargeAmount    Float            @default(0)
  costCentreId    Int?
  costCentre      CostCentre?      @relation(fields: [costCentreId], references: [id])
  lines           InvoiceLine[]
  payments        InvoicePayment[]
  entries         JournalEntry[]
  matches         ReconcileMatch[]
  subcontractReceipts SubcontractReceipt[]
  projectId       Int?
  project         Project?         @relation(fields: [projectId], references: [id])
  dueDate         DateTime?
  paymentTermId   Int?
  paymentTerm     PaymentTerm?     @relation(fields: [paymentTermId], references: [id])
  recurringId     Int?
  recurring       RecurringInvoice? @relation(fields: [recurringId], references: [id])
  instalments     InvoiceInstalment[]
  followUps       FollowUpLog[]
  timesheets      Timesheet[]
  milestones      ProjectMilestone[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([companyId, name])
  @@index([companyId, state])
  @@index([companyId, moveType])
  @@index([companyId, invoiceDate])
  @@index([companyId, state, moveType])
}

model InvoiceLine {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float
  subtotal    Float
  taxAmount   Float
  salesOrderLineId    Int?
  salesOrderLine      SalesOrderLine?    @relation(fields: [salesOrderLineId], references: [id])
  purchaseOrderLineId Int?
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  asset               Asset?
}

model InvoicePayment {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  /// bank, cash, wechat, alipay, card
  method    String
  paidAt    DateTime @default(now())
}

model JournalEntry {
  id        Int           @id @default(autoincrement())
  name      String
  journalId Int
  journal   Journal       @relation(fields: [journalId], references: [id])
  invoiceId Int?
  invoice   Invoice?      @relation(fields: [invoiceId], references: [id])
  date      DateTime
  companyId Int
  company   Company       @relation(fields: [companyId], references: [id])
  lines     JournalItem[]
  payrollRun PayrollRun?
  expenseClaim ExpenseClaim?
  depreciation AssetDepreciation?
  disposedAssets Asset[] @relation("AssetDisposal")
  valuations   ValuationLayer[]
  qualityAlerts QualityAlert[]
  reconcileMatches ReconcileMatch[]

  @@unique([companyId, name])
  @@index([companyId, date])
}

model JournalItem {
  id        Int          @id @default(autoincrement())
  entryId   Int
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId Int
  account   Account      @relation(fields: [accountId], references: [id])
  partnerId Int?
  label     String
  debit     Float        @default(0)
  credit    Float        @default(0)
  costCentreId Int?
  costCentre   CostCentre? @relation(fields: [costCentreId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@index([costCentreId])
}

model FiscalYear {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  startsOn  DateTime
  endsOn    DateTime
  closed    Boolean  @default(false)

  @@unique([companyId, name])
}

model CostCentre {
  id        Int           @id @default(autoincrement())
  companyId Int
  company   Company       @relation(fields: [companyId], references: [id])
  code      String
  name      String
  invoices  Invoice[]
  items     JournalItem[]

  @@unique([companyId, code])
}

model ChargeTemplate {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  /// sales or purchase
  side      String
  /// Percent of the untaxed amount.
  rate      Float

  @@unique([companyId, name])
}

model StockLedger {
  id           Int      @id @default(autoincrement())
  companyId    Int
  company      Company  @relation(fields: [companyId], references: [id])
  productId    Int
  product      Product  @relation(fields: [productId], references: [id])
  moveId       Int?
  qtyIn        Float    @default(0)
  qtyOut       Float    @default(0)
  value        Float
  balanceQty   Float
  balanceValue Float
  createdAt    DateTime @default(now())

  @@index([companyId, productId])
}

model StockBatch {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  name      String
  quantity  Float   @default(0)

  @@unique([companyId, productId, name])
}

model StockSerial {
  id         Int            @id @default(autoincrement())
  companyId  Int
  company    Company        @relation(fields: [companyId], references: [id])
  productId  Int
  product    Product        @relation(fields: [productId], references: [id])
  name       String
  locationId Int?
  location   StockLocation? @relation(fields: [locationId], references: [id])
  /// in_stock or issued
  state      String

  @@unique([companyId, name])
}

model Lead {
  id               Int        @id @default(autoincrement())
  name             String
  contactName      String
  email            String?
  phone            String?
  expectedRevenue  Float      @default(0)
  /// new, qualified, proposition, won, lost
  stage            String
  companyId        Int
  company          Company    @relation(fields: [companyId], references: [id])
  userId           Int?
  user             User?      @relation(fields: [userId], references: [id])
  contactId        Int?
  contact          Contact?   @relation(fields: [contactId], references: [id])
  orderId          Int?
  activities       Activity[]
  mailMembers      MailMember[]
  siteSubmissions  SiteSubmission[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([companyId, stage])
}

model Activity {
  id        Int       @id @default(autoincrement())
  leadId    Int
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// call, meeting, todo
  kind      String
  summary   String
  dueOn     DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String
  companyId Int
  company   Company    @relation(fields: [companyId], references: [id])
  employees Employee[]
  createdAt DateTime   @default(now())

  @@unique([companyId, name])
}

model Employee {
  id           Int          @id @default(autoincrement())
  name         String
  email        String?
  phone        String?
  jobTitle     String?
  /// What an hour of this person's time costs the company. Payroll still uses the monthly gross.
  hourlyCost   Float        @default(0)
  /// What an hour is billed at on a time-and-materials project. Zero uses the project rate.
  hourlyRate   Float        @default(0)
  active       Boolean      @default(true)
  departmentId Int?
  department   Department?  @relation(fields: [departmentId], references: [id])
  companyId    Int
  company      Company      @relation(fields: [companyId], references: [id])
  attendances  Attendance[]
  leaves       LeaveRequest[]
  salary       SalaryStructure?
  payslips     Payslip[]
  expenses     ExpenseClaim[]
  assignedTasks ProjectTask[]
  timesheets   Timesheet[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([companyId])
}

model Attendance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate   DateTime
  /// present, absent, late
  status     String
  note       String?
  createdAt  DateTime @default(now())

  @@unique([employeeId, workDate])
}

model LeaveRequest {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// annual, sick, personal
  kind       String
  dateFrom   DateTime
  dateTo     DateTime
  /// draft, approved, refused
  state      String   @default("draft")
  reason     String?
  createdAt  DateTime @default(now())

  @@index([employeeId, state])
}

/// One monthly gross per employee. Deduction maths is a demo approximation.
model SalaryStructure {
  id            Int      @id @default(autoincrement())
  companyId     Int
  company       Company  @relation(fields: [companyId], references: [id])
  employeeId    Int      @unique
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  monthlyGross  Float
  createdAt     DateTime @default(now())

  @@index([companyId])
}

model PayrollRun {
  id         Int          @id @default(autoincrement())
  name       String
  /// YYYY-MM
  period     String
  /// draft, posted, paid
  state      String
  companyId  Int
  company    Company      @relation(fields: [companyId], references: [id])
  payslips   Payslip[]
  entryId    Int?         @unique
  entry      JournalEntry? @relation(fields: [entryId], references: [id])
  createdAt  DateTime     @default(now())

  @@unique([companyId, name])
  @@index([companyId, period])
}

model Payslip {
  id          Int          @id @default(autoincrement())
  runId       Int
  run         PayrollRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee     @relation(fields: [employeeId], references: [id])
  gross       Float
  deduction   Float
  net         Float
  lines       PayslipLine[]

  @@unique([runId, employeeId])
}

model PayslipLine {
  id        Int     @id @default(autoincrement())
  payslipId Int
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  code      String
  label     String
  /// earning or deduction
  kind      String
  amount    Float
}

model DeskRecord {
  id         Int      @id @default(autoincrement())
  companyId  Int
  company    Company  @relation(fields: [companyId], references: [id])
  module     String
  screen     String
  name       String
  state      String   @default("draft")
  partner    String   @default("")
  owner      String   @default("")
  bucket     String   @default("")
  amount     Float    @default(0)
  notes      String   @default("")
  recordDate DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([companyId, module, screen, name])
  @@index([companyId, module, screen])
  @@index([companyId, module, screen, state])
  @@index([companyId, recordDate])
}

model ModuleSetting {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  module    String
  key       String
  value     String

  @@unique([companyId, module, key])
}

model ExpenseClaim {
  id          Int           @id @default(autoincrement())
  name        String
  companyId   Int
  company     Company       @relation(fields: [companyId], references: [id])
  employeeId  Int
  employee    Employee      @relation(fields: [employeeId], references: [id])
  merchant    String
  description String
  /// A receipt reference. The file itself is not stored.
  receiptRef  String
  amount      Float
  spentOn     DateTime
  /// submitted, approved, reimbursed, refused
  state       String
  entryId     Int?          @unique
  entry       JournalEntry? @relation(fields: [entryId], references: [id])
  projectId   Int?
  project     Project?      @relation(fields: [projectId], references: [id])
  createdAt   DateTime      @default(now())

  @@unique([companyId, name])
  @@index([companyId, state])
}

model AccessGroup {
  id        Int           @id @default(autoincrement())
  companyId Int
  company   Company       @relation(fields: [companyId], references: [id])
  key       String
  name      String
  members   GroupMember[]
  grants    ModelAccess[]
  rules     RecordRule[]

  @@unique([companyId, key])
}

model GroupMember {
  id      Int         @id @default(autoincrement())
  groupId Int
  group   AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  Int
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model ModelAccess {
  id        Int         @id @default(autoincrement())
  groupId   Int
  group     AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  model     String
  canRead   Boolean     @default(false)
  canWrite  Boolean     @default(false)
  canCreate Boolean     @default(false)
  canDelete Boolean     @default(false)

  @@unique([groupId, model])
}

model RecordRule {
  id      Int         @id @default(autoincrement())
  groupId Int
  group   AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  model   String
  name    String
  field   String
  op      String
  value   String

  @@index([groupId, model])
}

model SavedFilter {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  model     String
  name      String
  query     String   @default("")
  groupBy   String   @default("none")
  state     String   @default("all")

  @@unique([userId, model, name])
  @@index([companyId])
}

model ChatterMessage {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  model     String
  recordId  Int
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  kind      String
  summary   String
  createdAt DateTime @default(now())

  @@index([companyId, model, recordId])
}

model BankStatement {
  id             Int                 @id @default(autoincrement())
  companyId      Int
  company        Company             @relation(fields: [companyId], references: [id])
  bankAccountId  Int?
  bankAccount    BankAccount?        @relation(fields: [bankAccountId], references: [id])
  name           String
  statementDate  DateTime
  openingBalance Float               @default(0)
  lines          BankStatementLine[]

  @@unique([companyId, name])
}

model BankStatementLine {
  id          Int              @id @default(autoincrement())
  statementId Int
  statement   BankStatement    @relation(fields: [statementId], references: [id], onDelete: Cascade)
  companyId   Int
  lineDate     DateTime
  label        String
  amount       Float
  reference    String           @default("")
  /// Stable hash of date, amount, label, and reference. Re-imports skip a hash already stored.
  fingerprint  String           @default("")
  reconciled   Float            @default(0)
  matches      ReconcileMatch[]

  @@index([companyId])
  @@index([companyId, fingerprint])
}

model ReconcileMatch {
  id        Int               @id @default(autoincrement())
  lineId    Int
  line      BankStatementLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  invoiceId Int?
  invoice   Invoice?          @relation(fields: [invoiceId], references: [id])
  entryId   Int?
  entry     JournalEntry?     @relation(fields: [entryId], references: [id])
  companyId Int
  amount    Float
  /// payment posts cash against the invoice. link only clears the line. entry posts a fresh journal.
  kind      String            @default("payment")

  @@index([companyId, invoiceId])
}

model ValuationLayer {
  id        Int           @id @default(autoincrement())
  companyId Int
  company   Company       @relation(fields: [companyId], references: [id])
  productId Int
  product   Product       @relation(fields: [productId], references: [id])
  moveId    Int?
  quantity  Float
  remaining Float
  unitCost  Float
  value     Float
  method    String
  entryId   Int?
  entry     JournalEntry? @relation(fields: [entryId], references: [id])
  createdAt DateTime      @default(now())

  @@index([companyId, productId])
}

model StockRoute {
  id        Int             @id @default(autoincrement())
  companyId Int
  company   Company         @relation(fields: [companyId], references: [id])
  name      String
  kind      String
  steps     String
  transfers StockTransfer[]

  @@unique([companyId, name])
}

model CustomerGroup {
  id        Int           @id @default(autoincrement())
  companyId Int
  company   Company       @relation(fields: [companyId], references: [id])
  name      String
  contacts  Contact[]
  rules     PricingRule[]

  @@unique([companyId, name])
}

model PriceList {
  id        Int             @id @default(autoincrement())
  companyId Int
  company   Company         @relation(fields: [companyId], references: [id])
  name      String
  /// sales or purchase
  side      String          @default("sales")
  items     PriceListItem[]
  saleContacts Contact[] @relation("SaleList")
  buyContacts  Contact[] @relation("BuyList")

  @@unique([companyId, name])
}

model PriceListItem {
  id          Int       @id @default(autoincrement())
  priceListId Int
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  minQty      Float     @default(0)
  price       Float

  @@unique([priceListId, productId, minQty])
}

model PricingRule {
  id              Int            @id @default(autoincrement())
  companyId       Int
  company         Company        @relation(fields: [companyId], references: [id])
  name            String
  /// sales or purchase
  side            String
  productId       Int?
  product         Product?       @relation(fields: [productId], references: [id])
  minQty          Float          @default(1)
  discountPercent Float          @default(0)
  fixedPrice      Float?
  customerId      Int?
  customer        Contact?       @relation("RuleCustomer", fields: [customerId], references: [id])
  customerGroupId Int?
  customerGroup   CustomerGroup? @relation(fields: [customerGroupId], references: [id])
  vendorId        Int?
  vendor          Contact?       @relation("RuleVendor", fields: [vendorId], references: [id])
  active          Boolean        @default(true)

  @@unique([companyId, name])
}

model Quotation {
  id           Int             @id @default(autoincrement())
  companyId    Int
  company      Company         @relation(fields: [companyId], references: [id])
  name         String
  customerId   Int
  customer     Contact         @relation(fields: [customerId], references: [id])
  salesOrderId Int?
  salesOrder   SalesOrder?     @relation(fields: [salesOrderId], references: [id])
  /// draft, sent, ordered, cancel
  state        String
  lines        QuotationLine[]
  createdAt    DateTime        @default(now())

  @@unique([companyId, name])
}

model QuotationLine {
  id          Int       @id @default(autoincrement())
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   Int
  description String
  quantity    Float
  unitPrice   Float
  discount    Float     @default(0)
  taxId       Int?
}

model DeliveryNote {
  id           Int                @id @default(autoincrement())
  companyId    Int
  company      Company            @relation(fields: [companyId], references: [id])
  name         String
  salesOrderId Int
  salesOrder   SalesOrder         @relation(fields: [salesOrderId], references: [id])
  state        String
  date         DateTime
  lines        DeliveryNoteLine[]
  moves        StockMove[]

  @@unique([companyId, name])
}

model DeliveryNoteLine {
  id               Int            @id @default(autoincrement())
  noteId           Int
  note             DeliveryNote   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  salesOrderLineId Int
  orderLine        SalesOrderLine @relation(fields: [salesOrderLineId], references: [id])
  productId        Int
  quantity         Float
}

model PurchaseReceipt {
  id              Int                   @id @default(autoincrement())
  companyId       Int
  company         Company               @relation(fields: [companyId], references: [id])
  name            String
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  state           String
  date            DateTime
  landedCost      Float                 @default(0)
  lines           PurchaseReceiptLine[]
  moves           StockMove[]

  @@unique([companyId, name])
}

model PurchaseReceiptLine {
  id                  Int             @id @default(autoincrement())
  receiptId           Int
  receipt             PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId Int
  orderLine           PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  productId           Int
  quantity            Float
  unitCost            Float
}

model MaterialRequest {
  id        Int                   @id @default(autoincrement())
  companyId Int
  company   Company               @relation(fields: [companyId], references: [id])
  name      String
  /// draft, confirmed, ordered, cancel
  state     String
  lines     MaterialRequestLine[]
  quotes    SupplierQuotation[]
  manufacturingOrders ManufacturingOrder[]
  createdAt DateTime              @default(now())

  @@unique([companyId, name])
}

model MaterialRequestLine {
  id         Int             @id @default(autoincrement())
  requestId  Int
  request    MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId  Int
  quantity   Float
  qtyOrdered Float           @default(0)
}

model SupplierQuotation {
  id                Int                     @id @default(autoincrement())
  companyId         Int
  company           Company                 @relation(fields: [companyId], references: [id])
  name              String
  vendorId          Int
  vendor            Contact                 @relation(fields: [vendorId], references: [id])
  materialRequestId Int?
  materialRequest   MaterialRequest?        @relation(fields: [materialRequestId], references: [id])
  purchaseOrderId   Int?
  purchaseOrder     PurchaseOrder?          @relation(fields: [purchaseOrderId], references: [id])
  /// draft or received
  state             String
  lines             SupplierQuotationLine[]
  createdAt         DateTime                @default(now())

  @@unique([companyId, name])
}

model SupplierQuotationLine {
  id        Int               @id @default(autoincrement())
  quoteId   Int
  quote     SupplierQuotation @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId Int
  quantity  Float
  unitCost  Float
}

/// One guided-demo walk for a company. Document ids are plain numbers so a reset can delete the documents first.
model DemoRun {
  id                   Int      @id @default(autoincrement())
  companyId            Int
  company              Company  @relation(fields: [companyId], references: [id])
  userId               Int
  user                 User     @relation(fields: [userId], references: [id])
  step                 Int      @default(0)
  /// active, done, or skipped
  status               String   @default("active")
  serial               Int
  leadId               Int?
  quotationId          Int?
  salesOrderId         Int?
  purchaseOrderId      Int?
  manufacturingOrderId Int?
  invoiceId            Int?
  contactId            Int?
  finishedId           Int?
  componentId          Int?
  qualityPointId       Int?
  statementId          Int?
  projectId            Int?
  projectInvoiceId     Int?
  note                 String?
  /// Baseline stock and the story (product, material, quantity) captured before the first change.
  snapshot             Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([companyId])
}

/// Default accounts for a class of fixed assets. Depreciation posts through these.
model AssetCategory {
  id               Int      @id @default(autoincrement())
  companyId        Int
  company          Company  @relation(fields: [companyId], references: [id])
  name             String
  assetAccountId   Int
  assetAccount     Account  @relation("AssetAccount", fields: [assetAccountId], references: [id])
  accumAccountId   Int
  accumAccount     Account  @relation("AccumAccount", fields: [accumAccountId], references: [id])
  expenseAccountId Int
  expenseAccount   Account  @relation("DepExpenseAccount", fields: [expenseAccountId], references: [id])
  /// straight_line or declining
  method           String
  months           Int
  /// monthly
  frequency        String   @default("monthly")
  assets           Asset[]

  @@unique([companyId, name])
}

model Asset {
  id              Int                  @id @default(autoincrement())
  companyId       Int
  company         Company              @relation(fields: [companyId], references: [id])
  name            String
  categoryId      Int
  category        AssetCategory        @relation(fields: [categoryId], references: [id])
  purchaseValue   Float
  salvageValue    Float
  startDate       DateTime
  /// straight_line or declining
  method          String
  months          Int
  /// open, disposed, or sold
  state           String
  invoiceLineId   Int?                 @unique
  invoiceLine     InvoiceLine?         @relation(fields: [invoiceLineId], references: [id])
  disposalDate    DateTime?
  disposalPrice   Float?
  disposalEntryId Int?                 @unique
  disposalEntry   JournalEntry?        @relation("AssetDisposal", fields: [disposalEntryId], references: [id])
  lines           AssetDepreciation[]
  createdAt       DateTime             @default(now())

  @@unique([companyId, name])
  @@index([companyId, state])
}

model AssetDepreciation {
  id      Int           @id @default(autoincrement())
  assetId Int
  asset   Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date    DateTime
  amount  Float
  /// draft or posted
  state   String
  entryId Int?          @unique
  entry   JournalEntry? @relation(fields: [entryId], references: [id])

  @@unique([assetId, date])
}

model SubcontractOrder {
  id         Int                     @id @default(autoincrement())
  companyId  Int
  company    Company                 @relation(fields: [companyId], references: [id])
  name       String
  vendorId   Int
  vendor     Contact                 @relation("SubcontractVendor", fields: [vendorId], references: [id])
  productId  Int
  product    Product                 @relation("SubFinished", fields: [productId], references: [id])
  bomId      Int
  bom        BillOfMaterials         @relation(fields: [bomId], references: [id])
  locationId Int
  location   StockLocation           @relation(fields: [locationId], references: [id])
  quantity   Float
  /// Untaxed service fee for one finished unit.
  fee        Float
  /// draft, confirmed, progress, done, or cancel
  state      String
  received   Float                   @default(0)
  lines      SubcontractComponent[]
  receipts   SubcontractReceipt[]
  moves      StockMove[]
  createdAt  DateTime                @default(now())

  @@unique([companyId, name])
  @@index([companyId, state])
}

model SubcontractComponent {
  id        Int               @id @default(autoincrement())
  orderId   Int
  order     SubcontractOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product           @relation(fields: [productId], references: [id])
  /// Component quantity for one finished unit.
  perUnit   Float
  sent      Float             @default(0)
  consumed  Float             @default(0)
  valueSent Float             @default(0)
  valueUsed Float             @default(0)

  @@unique([orderId, productId])
}

model SubcontractReceipt {
  id            Int              @id @default(autoincrement())
  orderId       Int
  order         SubcontractOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quantity      Float
  componentCost Float
  fee           Float
  invoiceId     Int?
  invoice       Invoice?         @relation(fields: [invoiceId], references: [id])
  date          DateTime
}

model UserInvite {
  id          Int       @id @default(autoincrement())
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id])
  email       String
  role        String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById Int
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([companyId, email])
}

/// A control the company wants run when a product is received, made, or delivered.
model QualityPoint {
  id            Int            @id @default(autoincrement())
  companyId     Int
  company       Company        @relation(fields: [companyId], references: [id])
  name          String
  productId     Int
  product       Product        @relation(fields: [productId], references: [id])
  /// receipt, operation, or delivery
  trigger       String
  operationName String         @default("")
  /// pass_fail, measure, or checklist
  checkType     String
  minValue      Float?
  maxValue      Float?
  /// One checklist line per row.
  checklist     String         @default("")
  active        Boolean        @default(true)
  checks        QualityCheck[]
  createdAt     DateTime       @default(now())

  @@index([companyId, productId, trigger])
}

model QualityCheck {
  id                   Int                 @id @default(autoincrement())
  companyId            Int
  company              Company             @relation(fields: [companyId], references: [id])
  pointId              Int
  point                QualityPoint        @relation(fields: [pointId], references: [id])
  productId            Int
  product              Product             @relation(fields: [productId], references: [id])
  trigger              String
  operationName        String              @default("")
  /// pending, pass, or fail
  status               String              @default("pending")
  measured             Float?
  checklistDone        String              @default("")
  notes                String              @default("")
  quantity             Float               @default(0)
  purchaseOrderId      Int?
  purchaseOrder        PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  salesOrderId         Int?
  salesOrder           SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  manufacturingOrderId Int?
  manufacturingOrder   ManufacturingOrder? @relation(fields: [manufacturingOrderId], references: [id])
  vendorId             Int?
  vendor               Contact?            @relation("QualityVendor", fields: [vendorId], references: [id])
  overrideReason       String?
  overrideById         Int?
  overrideBy           User?               @relation("QualityOverride", fields: [overrideById], references: [id])
  overrideAt           DateTime?
  alert                QualityAlert?
  createdAt            DateTime            @default(now())

  @@index([companyId, status])
  @@index([purchaseOrderId])
  @@index([salesOrderId])
  @@index([manufacturingOrderId])
}

model QualityAlert {
  id         Int           @id @default(autoincrement())
  companyId  Int
  company    Company       @relation(fields: [companyId], references: [id])
  checkId    Int           @unique
  check      QualityCheck  @relation(fields: [checkId], references: [id])
  productId  Int
  product    Product       @relation("AlertProduct", fields: [productId], references: [id])
  vendorId   Int?
  vendor     Contact?      @relation("AlertVendor", fields: [vendorId], references: [id])
  /// open or resolved
  status     String        @default("open")
  /// rework, scrap, or return_vendor
  action     String?
  /// supplier (credited GRNI), stock (credited inventory), or none
  heldFrom   String        @default("none")
  quantity   Float
  /// Value parked on the quarantine account. Scrap and returns use this figure.
  value      Float         @default(0)
  note       String        @default("")
  entryId    Int?
  entry      JournalEntry? @relation(fields: [entryId], references: [id])
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([companyId, status])
}

model Project {
  id          Int                @id @default(autoincrement())
  companyId   Int
  company     Company            @relation(fields: [companyId], references: [id])
  name        String
  partnerId   Int?
  partner     Contact?           @relation(fields: [partnerId], references: [id])
  /// fixed or time
  billingType String
  hourlyRate  Float              @default(0)
  /// open or done
  state       String             @default("open")
  stages      ProjectStage[]
  tasks       ProjectTask[]
  timesheets  Timesheet[]
  milestones  ProjectMilestone[]
  expenses    ExpenseClaim[]
  invoices    Invoice[]
  createdAt   DateTime           @default(now())

  @@unique([companyId, name])
}

model ProjectStage {
  id        Int           @id @default(autoincrement())
  companyId Int
  projectId Int
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  sequence  Int
  tasks     ProjectTask[]

  @@index([projectId])
}

model ProjectTask {
  id         Int              @id @default(autoincrement())
  companyId  Int
  projectId  Int
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageId    Int
  stage      ProjectStage     @relation(fields: [stageId], references: [id])
  name       String
  assigneeId Int?
  assignee   Employee?        @relation(fields: [assigneeId], references: [id])
  deadline   DateTime?
  startDate  DateTime?
  endDate    DateTime?
  sequence   Int              @default(0)
  blockedBy  TaskDependency[] @relation("BlockedTask")
  blocking   TaskDependency[] @relation("BlockingTask")
  timesheets Timesheet[]

  @@index([projectId, stageId])
}

model TaskDependency {
  id          Int         @id @default(autoincrement())
  companyId   Int
  taskId      Int
  task        ProjectTask @relation("BlockedTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId Int
  dependsOn   ProjectTask @relation("BlockingTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

model Timesheet {
  id          Int         @id @default(autoincrement())
  companyId   Int
  projectId   Int
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      Int
  task        ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee    @relation(fields: [employeeId], references: [id])
  workDate    DateTime
  hours       Float
  /// draft, approved, or invoiced
  state       String      @default("draft")
  invoiceId   Int?
  invoice     Invoice?    @relation(fields: [invoiceId], references: [id])
  description String      @default("")
  createdAt   DateTime    @default(now())

  @@index([companyId, state])
  @@index([projectId])
}

model ProjectMilestone {
  id        Int       @id @default(autoincrement())
  companyId Int
  projectId Int
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  amount    Float
  dueDate   DateTime?
  /// open, approved, or invoiced
  state     String    @default("open")
  invoiceId Int?
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id])

  @@index([projectId, state])
}

model BankAccount {
  id          Int             @id @default(autoincrement())
  companyId   Int
  company     Company         @relation(fields: [companyId], references: [id])
  name        String
  accountCode String          @default("1002")
  currency    String
  statements  BankStatement[]

  @@unique([companyId, name])
}

/// When a statement line's text contains matchText, offer this posting.
model ReconcileRule {
  id          Int     @id @default(autoincrement())
  companyId   Int
  company     Company @relation(fields: [companyId], references: [id])
  name        String
  /// contains
  matchKind   String  @default("contains")
  matchText   String
  /// expense, fee, or transfer
  action      String
  accountCode String

  @@unique([companyId, name])
}

/// A mailing list built from customers, leads, or both. tag narrows the pull.
model MailList {
  id        Int          @id @default(autoincrement())
  companyId Int
  company   Company      @relation(fields: [companyId], references: [id])
  name      String
  /// customers, leads, or both
  segment   String       @default("both")
  tag       String       @default("")
  members   MailMember[]
  campaigns Campaign[]

  @@unique([companyId, name])
}

model MailMember {
  id        Int      @id @default(autoincrement())
  companyId Int
  listId    Int
  list      MailList @relation(fields: [listId], references: [id], onDelete: Cascade)
  email     String
  name      String   @default("")
  /// subscribed or unsubscribed
  status    String   @default("subscribed")
  contactId Int?
  contact   Contact? @relation(fields: [contactId], references: [id])
  leadId    Int?
  lead      Lead?    @relation(fields: [leadId], references: [id])

  @@unique([listId, email])
  @@index([companyId, email])
}

/// Addresses that must not be mailed again, even if they reappear on a list.
model MailSuppression {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  email     String
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@unique([companyId, email])
}

model MailTemplate {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  subject   String
  blocks    Json

  @@unique([companyId, name])
}

model Campaign {
  id          Int                  @id @default(autoincrement())
  companyId   Int
  company     Company              @relation(fields: [companyId], references: [id])
  listId      Int
  list        MailList             @relation(fields: [listId], references: [id])
  name        String
  subject     String
  /// Optional second subject. Recipients alternate when this is set.
  subjectB    String               @default("")
  /// draft, scheduled, or sent
  state       String               @default("draft")
  blocks      Json
  scheduledAt DateTime?
  sentAt      DateTime?
  /// resend, smtp, or simulate
  channel     String               @default("")
  recipients  CampaignRecipient[]

  @@unique([companyId, name])
  @@index([companyId, state])
}

model CampaignRecipient {
  id         Int       @id @default(autoincrement())
  companyId  Int
  campaignId Int
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email      String
  name       String    @default("")
  subject    String
  /// a or b
  variant    String    @default("a")
  token      String    @unique
  /// pending, sent, or bounced
  status     String    @default("pending")
  openedAt   DateTime?
  clickedAt  DateTime?
  openCount  Int       @default(0)
  clickCount Int       @default(0)
  sentAt     DateTime?

  @@index([companyId, sentAt])
  @@index([campaignId])
}

model SiteTheme {
  id        Int     @id @default(autoincrement())
  companyId Int     @unique
  company   Company @relation(fields: [companyId], references: [id])
  siteName  String  @default("")
  primary   String  @default("#0E6B5C")
  ink       String  @default("#1C2B2A")
  paper     String  @default("#F3F6F4")
  /// serif or sans
  font      String  @default("serif")
  logoUrl   String  @default("")
}

model SiteMenuItem {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  label     String
  href      String
  sequence  Int     @default(0)

  @@index([companyId, sequence])
}

model SitePage {
  id             Int     @id @default(autoincrement())
  companyId      Int
  company        Company @relation(fields: [companyId], references: [id])
  title          String
  slug           String
  seoTitle       String  @default("")
  seoDescription String  @default("")
  ogImage        String  @default("")
  /// draft or published
  state          String  @default("draft")
  blocks         Json
  sequence       Int     @default(0)

  @@unique([companyId, slug])
  @@index([companyId, state])
}

model BlogPost {
  id             Int       @id @default(autoincrement())
  companyId      Int
  company        Company   @relation(fields: [companyId], references: [id])
  title          String
  slug           String
  excerpt        String    @default("")
  body           String    @default("")
  coverUrl       String    @default("")
  seoTitle       String    @default("")
  seoDescription String    @default("")
  /// draft or published
  state          String    @default("draft")
  publishedAt    DateTime?

  @@unique([companyId, slug])
}

model SiteSubmission {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  email     String
  message   String
  leadId    Int?
  lead      Lead?    @relation(fields: [leadId], references: [id])
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

model PaymentTerm {
  id        Int               @id @default(autoincrement())
  companyId Int
  company   Company           @relation(fields: [companyId], references: [id])
  name      String
  lines     PaymentTermLine[]
  contacts  Contact[]
  invoices  Invoice[]

  @@unique([companyId, name])
}

model PaymentTermLine {
  id       Int         @id @default(autoincrement())
  termId   Int
  term     PaymentTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  sequence Int
  /// Share of the invoice total, 0 to 100.
  percent  Float
  /// Days after the invoice date.
  days     Int

  @@unique([termId, sequence])
}

model InvoiceInstalment {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sequence  Int
  dueDate   DateTime
  amount    Float
  percent   Float

  @@unique([invoiceId, sequence])
}

model FollowUpLevel {
  id          Int           @id @default(autoincrement())
  companyId   Int
  company     Company       @relation(fields: [companyId], references: [id])
  name        String
  daysOverdue Int
  sequence    Int
  logs        FollowUpLog[]

  @@unique([companyId, name])
}

model FollowUpLog {
  id        Int            @id @default(autoincrement())
  companyId Int
  invoiceId Int
  invoice   Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  levelId   Int
  level     FollowUpLevel  @relation(fields: [levelId], references: [id])
  channel   String
  sentAt    DateTime       @default(now())

  @@unique([invoiceId, levelId])
}

model RecurringInvoice {
  id          Int       @id @default(autoincrement())
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id])
  partnerId   Int
  partner     Contact   @relation(fields: [partnerId], references: [id])
  name        String
  intervalDays Int
  nextDate    DateTime
  active      Boolean   @default(true)
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float     @default(0)
  invoices    Invoice[]

  @@unique([companyId, name])
}

model CompanyTax {
  id           Int                @id @default(autoincrement())
  companyId    Int
  company      Company            @relation(fields: [companyId], references: [id])
  name         String
  code         String
  /// percent or fixed
  kind         String
  amount       Float
  priceInclude Boolean            @default(false)
  compound     Boolean            @default(false)
  withholding  Boolean            @default(false)
  sequence     Int                @default(0)
  active       Boolean            @default(true)
  groupLines   TaxGroupTax[]
  mapsFrom     FiscalPositionMap[] @relation("MapFrom")
  mapsTo       FiscalPositionMap[] @relation("MapTo")
  documentTaxes DocumentTax[]

  @@unique([companyId, code])
}

model TaxGroup {
  id        Int           @id @default(autoincrement())
  companyId Int
  company   Company       @relation(fields: [companyId], references: [id])
  name      String
  lines     TaxGroupTax[]

  @@unique([companyId, name])
}

model TaxGroupTax {
  id       Int        @id @default(autoincrement())
  groupId  Int
  group    TaxGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  taxId    Int
  tax      CompanyTax @relation(fields: [taxId], references: [id])
  sequence Int

  @@unique([groupId, taxId])
}

model FiscalPosition {
  id          Int                 @id @default(autoincrement())
  companyId   Int
  company     Company             @relation(fields: [companyId], references: [id])
  name        String
  /// ISO country code, or empty for any country.
  countryCode String              @default("")
  /// company, person, or empty for any partner.
  partnerKind String              @default("")
  maps        FiscalPositionMap[]
  contacts    Contact[]

  @@unique([companyId, name])
}

model FiscalPositionMap {
  id            Int             @id @default(autoincrement())
  positionId    Int
  position      FiscalPosition  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  taxId         Int
  tax           CompanyTax      @relation("MapFrom", fields: [taxId], references: [id])
  /// Empty removes the tax. Otherwise the replacement tax.
  replacementId Int?
  replacement   CompanyTax?     @relation("MapTo", fields: [replacementId], references: [id])

  @@unique([positionId, taxId])
}

model DocumentTax {
  id        Int        @id @default(autoincrement())
  companyId Int
  company   Company    @relation(fields: [companyId], references: [id])
  taxId     Int
  tax       CompanyTax @relation(fields: [taxId], references: [id])
  model     String
  recordId  Int
  base      Float
  amount    Float
  withheld  Boolean    @default(false)

  @@index([companyId, taxId])
  @@index([companyId, model, recordId])
}

model MailLog {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  model     String
  recordId  Int
  to        String
  subject   String
  body      String
  channel   String
  createdAt DateTime @default(now())

  @@index([companyId, model, recordId])
}

model FileBlob {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  model     String
  recordId  Int
  name      String
  mime      String
  size      Int
  bytes     Bytes?
  url       String?
  createdAt DateTime @default(now())

  @@index([companyId, model, recordId])
}

model HelpdeskTeam {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  tickets   Ticket[]

  @@unique([companyId, name])
}

model HelpdeskTag {
  id        Int         @id @default(autoincrement())
  companyId Int
  company   Company     @relation(fields: [companyId], references: [id])
  name      String
  tickets   TicketTag[]

  @@unique([companyId, name])
}

model SlaPolicy {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  /// low, normal, high, or urgent
  priority  String
  /// Hours from the ticket's creation until the deadline.
  hours     Int

  @@unique([companyId, priority])
}

model Ticket {
  id          Int             @id @default(autoincrement())
  companyId   Int
  company     Company         @relation(fields: [companyId], references: [id])
  number      String
  partnerId   Int
  partner     Contact         @relation(fields: [partnerId], references: [id])
  subject     String
  description String          @default("")
  teamId      Int?
  team        HelpdeskTeam?   @relation(fields: [teamId], references: [id])
  assigneeId  Int?
  assignee    User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  /// low, normal, high, or urgent
  priority    String          @default("normal")
  /// new, progress, waiting, solved, or closed
  stage       String          @default("new")
  slaDeadline DateTime?
  resolvedAt  DateTime?
  tags        TicketTag[]
  messages    TicketMessage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([companyId, number])
  @@index([companyId, stage])
}

model TicketTag {
  ticketId Int
  ticket   Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tagId    Int
  tag      HelpdeskTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
}

model TicketMessage {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorName String
  body       String
  internal   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([ticketId, createdAt])
}
