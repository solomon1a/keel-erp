{
  "name": "keel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "prisma migrate deploy && concurrently -n api,web -c blue,green \"tsx server/index.ts\" \"vite --host 0.0.0.0 --port 43123\"",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "test": "prisma generate && vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:reset": "node --env-file=.env --import tsx prisma/reset.ts && prisma migrate deploy && prisma db seed",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.0",
    "@tanstack/react-query": "^5.104.3",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.13",
    "prisma": "^6.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.57.0",
    "oxlint": "^1.81.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/client@6.19.0": true,
    "@prisma/engines@6.19.0": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.0": true
  }
}
